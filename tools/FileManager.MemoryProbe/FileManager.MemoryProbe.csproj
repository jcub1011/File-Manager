<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A developer tool, not a shipped artifact: JIT so it builds in seconds. It MEASURES the
         published AOT service from the outside; it must never be AOT itself, or every edit to the
         harness would cost a native link. -->
    <PublishAot>false</PublishAot>
    <RootNamespace>FileManager.MemoryProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contracts ONLY, deliberately. The harness must talk to the service exactly as the UI does —
         over the IPC wire — rather than reaching into engine internals, or it would measure a
         different code path than the one users hit. No src project may reference this back. -->
    <ProjectReference Include="..\..\src\FileManager.Contracts\FileManager.Contracts.csproj" />
  </ItemGroup>

</Project>

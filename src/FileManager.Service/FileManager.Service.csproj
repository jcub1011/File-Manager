<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- Timezone validation (PROFILE_TIMEZONE_INVALID) needs ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Background GC OFF. This service is idle almost all the time and then allocates hard for a few
         seconds during a dry run; what it needs afterwards is for the heap to actually shrink.
         Background (concurrent) gen2s are non-compacting by design and, per the GC docs, "don't reduce
         the total heap size by much". Turning it off makes every gen2 blocking and compacting, which
         is what returns pages. The cost is longer pauses during the burst — an accepted trade for a
         background service with no UI thread of its own.

         Note this is NOT ServerGarbageCollection: server GC's per-core heaps and much larger gen0
         budget are the wrong shape here, and it is also the only thing that would enable DATAS.

         Delivery is the subtle part. NativeAOT has no runtimeconfig.json parser; the SDK converts this
         property into a RuntimeHostConfigurationOption, which the ILC toolchain then embeds as a
         runtimeknob (System.GC.Concurrent=false). It also lands in the generated runtimeconfig.json,
         so `dotnet run` and the published AOT binary agree. EngineHost logs the resolved GC
         configuration at startup — that log line is how you confirm this actually took effect, rather
         than assuming it because the csproj says so. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Trade some throughput for a smaller footprint, and auto-compact a fragmented Large Object
         Heap. There is no MSBuild property for this one, so it goes in as a raw host configuration
         option; the AOT toolchain turns it into a runtimeknob exactly as it does for the properties
         above, and it also reaches the generated runtimeconfig.json for the JIT dev loop.

         Confirm it took effect from EngineHost's startup GC-configuration log line rather than from
         this file: there is an open report (dotnet/runtime#93914) of a correctly-set ConserveMemory
         producing no observable change. Revert if it does not move the measured number. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the tests can build EngineComposition's graph and drive EngineHost's startup sequence.
         Both are internal and were previously unreachable from any test, which is why the smoke
         test hand-rebuilt the graph (and drifted three handlers behind it). -->
    <InternalsVisibleTo Include="FileManager.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileManager.Contracts\FileManager.Contracts.csproj" />
    <ProjectReference Include="..\FileManager.Core\FileManager.Core.csproj" />
    <ProjectReference Include="..\FileManager.Platform.Windows\FileManager.Platform.Windows.csproj" />
  </ItemGroup>

</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:FileManager.UI.Controls"
        xmlns:st="using:FileManager.UI.ViewModels.Settings"
        xmlns:converters="using:Avalonia.Controls.Converters">

    <!-- Status indicator (dry-run): a colour-tinted glyph + optional count. Replaces the old filled
         status pills; the icon carries the meaning (pair with ToolTip.Tip), the text an optional
         count (hidden when empty → icon-only). -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type ctrl:StatusCount}" TargetType="ctrl:StatusCount">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                  Data="{TemplateBinding Icon}" Foreground="{TemplateBinding Glyph}" />
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Font.Small}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{TemplateBinding Text}"
                                   IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Per-level indent for the settings navigation tree, much tighter than Fluent's default 16px
             (see SettingsNavTreeViewItemTheme below, which is the only consumer). -->
        <x:Double x:Key="SettingsTreeIndent">6</x:Double>

        <!-- A re-templated TreeViewItem for the settings navigation tree only (assigned via
             TreeView.settingsNav's ItemContainerTheme). BasedOn the Fluent default so every visual state
             (hover/selected/disabled) is inherited unchanged; only the Template is replaced, shrinking the
             expand/collapse chevron's reserved space from Fluent's fixed ~36px (12px margin either side of
             a 12px glyph, present on every row including leaves and top-level items) down to ~24px, on top
             of the smaller per-level indent above. -->
        <ControlTheme x:Key="SettingsNavTreeViewItemTheme" TargetType="TreeViewItem"
                      BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Border Name="PART_LayoutRoot"
                                Classes="TreeViewItemLayoutRoot"
                                Focusable="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                MinHeight="{TemplateBinding MinHeight}"
                                TemplatedControl.IsTemplateFocusTarget="True">
                            <Grid Name="PART_Header" ColumnDefinitions="Auto,*">
                                <Grid.Margin>
                                    <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <DynamicResource ResourceKey="SettingsTreeIndent" />
                                    </MultiBinding>
                                </Grid.Margin>
                                <Panel Name="PART_ExpandCollapseChevronContainer" Margin="4,0,4,0">
                                    <ToggleButton Name="PART_ExpandCollapseChevron"
                                                  Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                                  Width="10" Height="10"
                                                  Focusable="False"
                                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                                </Panel>
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        IsVisible="{TemplateBinding IsExpanded}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                <Setter Property="Width" Value="10" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!--
      Shared, class-based styles layered on top of FluentTheme. Included after <FluentTheme/> in
      App.axaml so these win. Colours come from Tokens.axaml (DynamicResource so they track the
      light/dark variant). Hover/pressed states on Fluent-templated controls must target
      "/template/ ContentPresenter" because Fluent paints those states inside the template rather
      than through the control's own Background property.
    -->

    <!-- ============================ Title-bar chrome ============================
         Flat, transparent icon buttons (title bar + tool-window toolbars). Also used for the
         list's row delete button. -->
    <Style Selector="Button.iconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
    </Style>
    <Style Selector="Button.iconButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Selected}" />
    </Style>
    <!-- Same button, sitting on a chrome-coloured bar rather than a panel. The two states above are
         lifts off Brush.Panel.Background and all but vanish against Brush.Chrome.Background — in the
         dark variant Brush.Item.Hover (#2A2D2E) is actually a shade DARKER than the chrome it would
         sit on (#2D2D30), so hovering reads as nothing at all. A translucent mid-grey shows up on
         either surface in either variant, which is the trick Button.caption already uses to stay
         visible on the title bar. Must follow the two rules above to win: equal-priority setters
         resolve by document order. -->
    <Style Selector="Button.iconButton.onChrome:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22808080" />
    </Style>
    <Style Selector="Button.iconButton.onChrome:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#38808080" />
    </Style>
    <!-- Idle glyphs sit at the secondary weight and brighten on hover — softer and more
         cohesive than stark full-contrast icons. -->
    <Style Selector="Button.iconButton PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="Button.iconButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- Tint variants for icon-only buttons whose glyph is their whole label: the colour carries the
         meaning the solid-fill text buttons used to (accent = commit, red = destructive, green =
         inspect). One constant tint across idle and hover — the hover fill behind the glyph is the
         feedback. These must stay AFTER the two rules above: equal-priority style setters are resolved
         by document order, so an earlier tint would lose the hover state back to Brush.Text.Primary.
         Tinting via a class rather than a Foreground on the PathIcon itself is deliberate — a local
         value on the element outranks every one of these styles at once, hover rule included. -->
    <Style Selector="Button.iconButton.tintAccent PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.iconButton.tintDanger PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style Selector="Button.iconButton.tintSuccess PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
    </Style>
    <!-- Amber: go, but look before you do. For Approve Run, which is irreversible without being an
         outright destructive action of its own. -->
    <Style Selector="Button.iconButton.tintWarning PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <!-- Fluent greys a disabled button through its template's ContentPresenter foreground, which every
         explicit PathIcon foreground above defeats — so say it outright. Last, so it beats the tints. -->
    <Style Selector="Button.iconButton:disabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
    </Style>

    <!-- Caption buttons (minimize/maximize/close). WindowDecorations="BorderOnly" keeps the OS
         resize border but draws no system caption, so we size our own to the standard 46x32. -->
    <Style Selector="Button.caption">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Icon button sitting ON the solid accent status strip. Button.iconButton can't be reused:
         it takes the theme foreground, which renders near-invisible against the accent fill. -->
    <Style Selector="Button.statusBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusBar.Foreground}" />
    </Style>
    <Style Selector="Button.statusBar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Button.statusBar:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#40FFFFFF" />
    </Style>
    <Style Selector="Button.statusBar:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#19808080" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F808080" />
    </Style>
    <!-- Close gets the conventional Windows 11 red hover with a light glyph. -->
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#B4271C" />
    </Style>
    <Style Selector="Button.caption.close:pointerover PathIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ============================ Buttons ============================
         A compact, slightly-tighter default that reads more like a desktop tool button. -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    </Style>

    <!-- Destructive action button (red). -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#C62828" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#B71C1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- "Go" action button (green): the manual Run. Same shape as Button.danger, and like it the
         hover/press shades are literal darker steps of Brush.Success rather than tokens of their
         own — nothing else needs them. -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#47825D" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#3B6E4E" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- The Run glyph must follow the button's white foreground, not the theme's icon brush. -->
    <Style Selector="Button.success PathIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ============================ Inputs ============================ -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    </Style>

    <!-- ============================ Text roles ============================ -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Tool-window header, e.g. "PROFILES" (write the text upper-cased in the view). -->
    <Style Selector="TextBlock.panelHeader">
        <Setter Property="FontSize" Value="{StaticResource Font.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Field label in the two-column editor/settings grids. -->
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Section header with a hairline rule beneath (wrap the header text in this Border). -->
    <Style Selector="Border.sectionHeader">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="Margin" Value="0,18,0,10" />
    </Style>
    <Style Selector="Border.sectionHeader > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- ============================ Surfaces ============================ -->
    <!-- Subtle grouped container. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
    </Style>

    <!-- Info bar (VS-style inline message): 1px semantic border over a soft tint. Base is neutral;
         add .danger/.warning/.success/.info to colour it. -->
    <Style Selector="Border.infoBar">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Border}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.infoBar.danger">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
    </Style>
    <Style Selector="Border.infoBar.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
    </Style>
    <Style Selector="Border.infoBar.success">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
    </Style>
    <Style Selector="Border.infoBar.info">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Soft}" />
    </Style>

    <!-- Flyout popup surface (the only flyout in the app is the dry-run facet filter). Match the
         token-driven card look instead of Fluent's stock presenter chrome, and cap the width so a
         long list of facet keys wraps rather than sprawling across the screen. -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="MaxWidth" Value="440" />
    </Style>

    <!-- Card-like Expander (the dry-run Storage panel). The header/content backgrounds and borders
         are neutralised inline on the instance (Expander.Resources) so the wrapping Border.card
         surface shows through; here we only tune the styled properties. -->
    <Style Selector="Expander.card">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- (Status pills/chips and the dead per-target "kind" text tags were replaced by the
         ctrl:StatusCount control above — the dry-run view was their only consumer.) -->

    <!-- ============================ Profile list ============================
         VS Solution-Explorer feel: transparent rows, subtle hover, an accent left-bar on the
         selected row. Fluent already draws an accent bar on selected ListBoxItems; we tune the
         fill/spacing and let the accent override (Tokens.axaml) colour it VS blue. -->
    <Style Selector="ListBox.profiles">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.profiles ListBoxItem">
        <!-- Inert: ProfileListView overrides this to 0 and carries the inset on the template's Border
             instead, so the whole row is right-clickable. Kept in step with that value. -->
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    </Style>

    <!-- ====================== Collapsed profile rail ======================
         The collapsed sidebar: one acronym avatar per profile, centred. Selection and hover are
         drawn on the avatar Border itself (not the default ListBoxItem chrome), so we blank the
         Fluent selection background/pipe and let the avatar carry the accent. Disabled (locked)
         rows keep Fluent's reduced opacity as the "switch blocked" cue. -->
    <Style Selector="ListBox.profilesRail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Vertical spacing comes from the list: top/bottom padding + inter-item gap (ItemsPanel
             Spacing in ProfileRailView). Horizontal spacing comes from the collapsed column width
             centring the avatar. -->
        <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="ListBox.profilesRail ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Suppress the default row selection chrome; the avatar handles all visuals. -->
    <Style Selector="ListBox.profilesRail ListBoxItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.profilesRail ListBoxItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.profilesRail ListBoxItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ListBox.profilesRail Border.avatar">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.profilesRail Border.avatar > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ListBox.profilesRail ListBoxItem:pointerover Border.avatar">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
    </Style>
    <Style Selector="ListBox.profilesRail ListBoxItem:selected Border.avatar">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ListBox.profilesRail ListBoxItem:selected Border.avatar > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}" />
    </Style>

    <!-- ============================ Document tabs ============================
         The Profile / Dry Run switch is a primary navigation control, so give it real presence:
         larger type, generous hit target, a divider rule beneath the strip, and a bold accent
         underline on the selected tab. -->
    <Style Selector="TabControl.documents > TabItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="TabControl.documents > TabItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="TabControl.documents > TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
    </Style>
    <!-- Thicken the selected-tab accent underline so the switch reads as a real tab bar. -->
    <Style Selector="TabControl.documents > TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- ============================ Dry-run status chips ============================
         The dry-run summary counts double as filters: each is a toggleable StatusCount. Idle it
         reads like the old read-only summary (flat, no chrome); checked it gains a soft tinted fill
         and an accent border so an active filter is obvious. The border stays 1px in every state so
         toggling never shifts the row's layout. Fluent paints the checked/hover fill inside the
         template, so the state selectors target /template/ ContentPresenter. -->
    <Style Selector="ToggleButton.statusFilter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton.statusFilter:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.statusFilter:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ToggleButton.statusFilter:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- ============================ Settings ============================
         One setting in the Settings window: a scroll anchor the navigation tree can bring into view.
         The 3px left border is always present (transparent when unselected) so highlighting the
         navigated-to setting never shifts the layout. -->
    <Style Selector="Border.settingCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- Hover reads as the quieter of the two states (Item.Hover is a plainer wash than Item.Selected,
         and it gets no accent edge), so pointing at a setting never looks like selecting one. -->
    <Style Selector="Border.settingCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
    </Style>
    <!-- Declared after the hover rule so selection wins where they overlap; the third rule keeps the
         selected look while the pointer is over it, rather than letting hover wash it out. -->
    <Style Selector="Border.settingCard.selected">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.settingCard.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Item.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!-- The setting's name; heavier than its description but lighter than a section header. -->
    <Style Selector="TextBlock.settingTitle">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- Live per-value feedback under a setting's editor ("this path does not exist, the service will
         start from … instead"). Info reads as ordinary secondary prose; the two louder states are
         coloured but stay plain text, because a full infoBar per setting would out-shout the window's
         one real error banner. -->
    <Style Selector="TextBlock.settingNotice">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.settingNotice.warning">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style Selector="TextBlock.settingNotice.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <!-- A setting that cannot be edited right now (a service-owned one while the service is
         unreachable). Only the card's own text is dimmed here: the editor inside is disabled, which the
         control themes already grey, while the CARD stays enabled on purpose so it can still show the
         tooltip explaining why — a disabled Avalonia control receives no pointer input, so a tooltip on
         it would never appear. Declared AFTER .settingTitle so it wins for the title too; both
         selectors match, and the later setter is the one that applies. -->
    <Style Selector="Border.settingCard.disabled > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
    </Style>

    <!-- Settings navigation tree (VS tool-window look: flat rows, no chrome of its own). Node
         visibility and expansion are driven from the view model so the search box can filter the tree;
         hiding the TreeViewItem itself (not the template content) is what stops a filtered-out node
         leaving a gap behind. -->
    <Style Selector="TreeView.settingsNav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource SettingsNavTreeViewItemTheme}" />
    </Style>
    <Style Selector="TreeView.settingsNav TreeViewItem" x:DataType="st:SettingsNavNodeViewModel">
        <Setter Property="IsVisible" Value="{Binding IsVisible}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:FileManager.UI.Converters"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:v="using:FileManager.UI.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="FileManager.UI.Views.JobQueueWindow"
        x:DataType="vm:JobQueueViewModel"
        Width="1040" Height="640"
        MinWidth="840" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource Font.Body}"
        Background="{DynamicResource Brush.Window.Background}"
        Title="Job queue"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <!-- NON-MODAL (shown with Show, not ShowDialog — see App.axaml.cs). The whole point of a queue is to
         watch work while carrying on editing profiles, so this window must never block the main one.
         Every other secondary window in the app is a dialog; this is the deliberate exception.

         Chrome and layout follow SettingsWindow exactly: a custom title bar with an accent-badged icon,
         and a pinned footer holding the buttons and any message. Same recipe, same reasons — the OS keeps
         the resizable frame but draws no system caption, so the bar follows the app theme instead of the
         Windows default. -->

    <DockPanel LastChildFill="True">

        <!-- The ElementRole markers are load-bearing: TitleBar makes the grid the drag region, and the
             close button needs its own role or the drag region swallows its clicks. -->
        <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="Auto,*,Auto"
              Background="{DynamicResource Brush.Chrome.Background}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource Brush.Accent}">
                    <!-- The same glyph the main window's queue button uses, so the entry point and the
                         window it opens are recognizably one thing. -->
                    <PathIcon Data="{StaticResource IconOverwrite}" Width="11" Height="11" Foreground="White" />
                </Border>
                <TextBlock Text="Job queue" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="{StaticResource Font.Title}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <!-- The count the main window's badge shows, repeated here: with the window open the badge
                     is behind it, and "3 running" is the first thing a queue should say about itself. -->
                <TextBlock Classes="caption" VerticalAlignment="Center" Margin="10,0,0,0"
                           IsVisible="{Binding HasRuns}">
                    <Run Text="{Binding ActiveCount}" />
                    <Run Text="active" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="2" Classes="caption close"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                    Click="OnCloseClick" ToolTip.Tip="Close the job queue">
                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Footer: pinned so the buttons and any message stay put however far the list scrolls. Split
             like the settings footer — actions on the content to the left, the action that resolves the
             window to the right. -->
        <Border DockPanel.Dock="Bottom" Padding="16,10"
                Background="{DynamicResource Brush.Chrome.Background}"
                BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <Border Classes="infoBar danger"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="iconButton onChrome" Command="{Binding DismissErrorCommand}"
                                Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Dismiss">
                            <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
                        </Button>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Labelled and filled, like the settings footer: these two resolve the window (or
                         re-read everything in it) and are worth naming. No onChrome — that class exists
                         only to make a transparent button's hover visible on this bar's chrome fill, and
                         a filled button brings its own. The Dismiss cross inside the error bar above is
                         still transparent, so it still needs it. -->
                    <Button Grid.Column="0" Classes="iconButton hasLabel" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Refresh — re-read the queue from the service">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <!-- One size down, as everywhere else: a bare cross fills its box corner to corner
                             and overshoots the outline glyphs beside it at a matched size. -->
                        <Button x:Name="FooterCloseButton"
                                Classes="iconButton hasLabel tintDanger" Click="OnCloseClick"
                                ToolTip.Tip="Close the job queue. Runs keep going — this window only stops watching them.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Close" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- TWO PANES, draggably split: the live list on the left, the selected run's summary on the
             right. Master/detail like ActivityView, and for the same reason — the left pane's rows are a
             fixed shape that gains nothing from extra width, while the summary is prose, paths and storage
             bars that do.

             MinWidth on both content columns so neither can be dragged away entirely. The left minimum is
             what the row cards need before the profile name starts trimming; the right is what the
             settings block's label column plus a value needs before it wraps to one word per line.

             NO MARGIN ON THIS GRID — each pane insets its own content instead. The margin used to live here
             and it put the grab area in the wrong place: the splitter sat flush against the list while the
             visible rule (the summary panel's left border) was a dozen pixels further right, so the thing
             that looked like the divider was not the thing that resized. The splitter is now the divider,
             drawn and hovering as one. -->
        <Grid x:Name="SplitRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid.Styles>
                <!-- The divider IS the handle. It used to be a 4px transparent column, which hit-tested
                     correctly and looked like nothing at all — the user could only find it by sweeping the
                     cursor for the resize arrow. Painted as the same hairline every other panel edge uses,
                     and picking up the accent under the pointer so it reads as grabbable before it is
                     grabbed. -->
                <Style Selector="GridSplitter.pane">
                    <Setter Property="Background" Value="{DynamicResource Brush.Panel.Border}" />
                </Style>
                <Style Selector="GridSplitter.pane:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                </Style>

                <!-- Strip the default ListBoxItem chrome so the row's own Border.card is the whole visible
                     row, exactly as DryRunView does for its own row lists. Selection is drawn by the
                     ListBoxItem underneath the card, which is transparent-bordered, so the accent reads
                     through as a highlight around it. -->
                <Style Selector="ListBox.runs">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="ListBox.runs > ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
                <Style Selector="ListBox.runs > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover.Soft}" />
                </Style>
            </Grid.Styles>

            <!-- ── Left: the queue ──────────────────────────────────────────────────────────────── -->
            <!-- ALWAYS a list, with no header paragraph above it and no full-pane empty state instead of
                 it. Both used to be here; both made the pane change shape depending on what was in it, so
                 the eye had to re-find the list every time the queue went from empty to busy. An empty
                 queue now shows one placeholder ROW in the list's own position (below), which keeps the
                 layout still. What pausing and cancelling actually do is stated on the buttons that do
                 them, in the summary footer, which is where a reader is when the question arises. -->
            <Grid x:Name="QueuePane" Grid.Column="0" Margin="16,16,16,16">

                <!-- The empty state, shaped as a job card so it sits exactly where the first row would.
                     Dashed, because a dashed outline is the standard "nothing here yet" affordance and it
                     cannot be mistaken for a selectable row. A Rectangle rather than a Border: Avalonia's
                     Border draws a solid stroke only, so the dash has to come from a shape. -->
                <Grid x:Name="EmptyQueueCard" IsVisible="{Binding HasNoRuns}"
                      VerticalAlignment="Top" Height="64">
                    <!-- Radius.CardScalar, not Radius.Card: a shape's radii are doubles and the card token
                         is a CornerRadius, so the latter throws on populate. -->
                    <Rectangle RadiusX="{StaticResource Radius.CardScalar}"
                               RadiusY="{StaticResource Radius.CardScalar}"
                               StrokeThickness="1" StrokeDashArray="4,3"
                               Stroke="{DynamicResource Brush.Panel.Border}" />
                    <TextBlock Text="No Jobs In Queue" Classes="secondary"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- A ListBox rather than the ItemsControl this was, which is what makes a row SELECTABLE
                     and therefore what the summary pane follows. The swap was previously blocked: every
                     row button bound its command through $parent[ItemsControl], so changing the container
                     type would have broken all six. Moving those buttons into the summary footer removed
                     the last one, and only then did this become a two-line change.

                     Still VIRTUALIZED, and for the same reason as before: runs are retained until
                     discarded (up to MaxRetainedClosedRuns), so this list can be hundreds of cards deep
                     and a non-virtualizing panel would realize every one up front. -->
                <!-- No IsVisible gate: the list is always the list. An empty one simply lays out nothing,
                     and the dashed placeholder above shows through where its first row would be. -->
                <ListBox Classes="runs" ItemsSource="{Binding Runs}"
                         SelectedItem="{Binding SelectedRun}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobQueueRow">
                            <!-- .old dims a run that finished a while ago: history rather than news. The
                                 class is what the ten-minute mark does now that it no longer deletes. -->
                            <Border Classes="card" Classes.old="{Binding IsOld}"
                                    Margin="0,0,0,6" Padding="10,8" Background="Transparent">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">

                                    <!-- Glyph + colour arrive as resource-key strings from the view model,
                                         resolved here — the same approach the activity and dry-run rows use,
                                         so the view model needs no Avalonia dependency. -->
                                    <PathIcon Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                              Width="16" Height="16" Margin="0,0,10,0"
                                              VerticalAlignment="Top"
                                              Data="{Binding StatusIconKey, Converter={x:Static conv:IconConverters.Geometry}}"
                                              Foreground="{Binding StatusColorKey, Converter={x:Static conv:IconConverters.Brush}}" />

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding StartedText}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding StatusText}" />
                                        </TextBlock>

                                        <!-- PLANNING: the two scan counts, each on its own line. This is
                                             the phase's only news, and the destination line disappears
                                             rather than reading zero — most profiles never sweep their
                                             destination, and "0 at the destination" reads as a fault. -->
                                        <TextBlock Classes="caption" Text="{Binding ScanSourcesText}"
                                                   Foreground="{DynamicResource Brush.Info}"
                                                   IsVisible="{Binding IsPlanning}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="caption" Text="{Binding ScanDestinationsText}"
                                                   Foreground="{DynamicResource Brush.Info}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="IsPlanning" />
                                                    <Binding Path="HasScannedDestinations" />
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>

                                        <!-- What planning is doing when the counts above are not the
                                             answer: once the walk ends they freeze while the work list
                                             is written, which from out here looks exactly like a walk
                                             that has wedged. Hidden while scanning — the source line
                                             is already saying that. -->
                                        <TextBlock Classes="caption" Text="{Binding PlanStageText}"
                                                   Foreground="{DynamicResource Brush.Info}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="IsPlanning" />
                                                    <Binding Path="HasPlanStageNote" />
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>

                                        <!-- Every other phase's one-liner: queued, the parked plan's
                                             forecast, the executing file counts. -->
                                        <TextBlock Classes="caption" Text="{Binding ProgressText}"
                                                   Foreground="{DynamicResource Brush.Info}"
                                                   IsVisible="{Binding !IsPlanning}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Shown for every finished row, not just old ones. Runs are kept
                                             now, so "when" is as much a part of the row as "what". -->
                                        <TextBlock Classes="caption" Text="{Binding FinishedAgeText}"
                                                   IsVisible="{Binding HasFinishedAge}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ProgressBar Grid.Row="1" Grid.Column="1"
                                                 Margin="0,6,0,0" Height="4"
                                                 IsVisible="{Binding ShowProgress}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" />

                                    <!-- The bar's own caption, and the point of the whole byte pipeline: a
                                         run of one disk image and ten thousand thumbnails sits at 99% by
                                         file count while the image is still copying, so DATA is what says
                                         how far along it is. Absent while planning (no denominator) and
                                         against a service too old to report bytes, where the bar silently
                                         falls back to counting files. -->
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption"
                                               Margin="0,2,0,0" Text="{Binding ByteProgressText}"
                                               IsVisible="{Binding HasByteProgress}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Classes="pane" ResizeDirection="Columns"
                          ToolTip.Tip="Drag to resize" />

            <!-- ── Right: the selected run ──────────────────────────────────────────────────────── -->
            <!-- Its own panel surface, the app's convention for a docked pane, so the split reads as two
                 regions rather than one wide list. No left border of its own — the splitter beside it draws
                 the divider now, and a second rule 6px away read as a double line.

                 Full-bleed to the frame on all three outer edges (this grid carries no margin, and the pane
                 insets its own content) so its footer meets the window footer. DataContext is deliberately
                 the whole view model — see RunSummaryPane.axaml for why it needs both halves. -->
            <Border x:Name="SummaryPaneHost" Grid.Column="2"
                    Background="{DynamicResource Brush.Panel.Background}">
                <v:RunSummaryPane DataContext="{Binding}" />
            </Border>
        </Grid>
    </DockPanel>

</Window>

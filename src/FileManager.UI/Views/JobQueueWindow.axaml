<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:FileManager.UI.Converters"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="FileManager.UI.Views.JobQueueWindow"
        x:DataType="vm:JobQueueViewModel"
        Width="720" Height="520"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource Font.Body}"
        Background="{DynamicResource Brush.Window.Background}"
        Title="Job queue"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <!-- NON-MODAL (shown with Show, not ShowDialog — see App.axaml.cs). The whole point of a queue is to
         watch work while carrying on editing profiles, so this window must never block the main one.
         Every other secondary window in the app is a dialog; this is the deliberate exception.

         Chrome and layout follow SettingsWindow exactly: a custom title bar with an accent-badged icon,
         and a pinned footer holding the buttons and any message. Same recipe, same reasons — the OS keeps
         the resizable frame but draws no system caption, so the bar follows the app theme instead of the
         Windows default. -->

    <DockPanel LastChildFill="True">

        <!-- The ElementRole markers are load-bearing: TitleBar makes the grid the drag region, and the
             close button needs its own role or the drag region swallows its clicks. -->
        <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="Auto,*,Auto"
              Background="{DynamicResource Brush.Chrome.Background}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource Brush.Accent}">
                    <!-- The same glyph the main window's queue button uses, so the entry point and the
                         window it opens are recognizably one thing. -->
                    <PathIcon Data="{StaticResource IconOverwrite}" Width="11" Height="11" Foreground="White" />
                </Border>
                <TextBlock Text="Job queue" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="{StaticResource Font.Title}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <!-- The count the main window's badge shows, repeated here: with the window open the badge
                     is behind it, and "3 running" is the first thing a queue should say about itself. -->
                <TextBlock Classes="caption" VerticalAlignment="Center" Margin="10,0,0,0"
                           IsVisible="{Binding HasRuns}">
                    <Run Text="{Binding ActiveCount}" />
                    <Run Text="active" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="2" Classes="caption close"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                    Click="OnCloseClick" ToolTip.Tip="Close the job queue">
                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Footer: pinned so the buttons and any message stay put however far the list scrolls. Split
             like the settings footer — actions on the content to the left, the action that resolves the
             window to the right. -->
        <Border DockPanel.Dock="Bottom" Padding="16,10"
                Background="{DynamicResource Brush.Chrome.Background}"
                BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <Border Classes="infoBar danger"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="iconButton onChrome" Command="{Binding DismissErrorCommand}"
                                Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Dismiss">
                            <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
                        </Button>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Labelled and filled, like the settings footer: these two resolve the window (or
                         re-read everything in it) and are worth naming. No onChrome — that class exists
                         only to make a transparent button's hover visible on this bar's chrome fill, and
                         a filled button brings its own. The Dismiss cross inside the error bar above is
                         still transparent, so it still needs it. -->
                    <Button Grid.Column="0" Classes="iconButton hasLabel" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Refresh — re-read the queue from the service">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <!-- One size down, as everywhere else: a bare cross fills its box corner to corner
                             and overshoots the outline glyphs beside it at a matched size. -->
                        <Button x:Name="FooterCloseButton"
                                Classes="iconButton hasLabel tintDanger" Click="OnCloseClick"
                                ToolTip.Tip="Close the job queue. Runs keep going — this window only stops watching them.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Close" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <DockPanel Margin="16" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Classes="secondary" Margin="0,0,0,8"
                       Text="Every run this engine knows about, including previews. Pausing holds work that has not started — files already being copied always finish. Runs are forgotten a few minutes after they end." />

            <StackPanel IsVisible="{Binding HasNoRuns}" VerticalAlignment="Center" Spacing="8">
                <PathIcon Data="{StaticResource IconDocument}" Width="28" Height="28"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Nothing running. Preview or run a profile and it will appear here." />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding HasRuns}">
                <ItemsControl ItemsSource="{Binding Runs}">
                    <!-- VIRTUALIZED. An ItemsControl's default panel realizes every item, which was fine
                         when the engine forgot a finished run after ten minutes and the list was a handful
                         of rows. Runs are now retained until discarded (up to MaxRetainedClosedRuns), so
                         this list can be hundreds of cards deep and every one of them would otherwise be
                         built up front. Kept an ItemsControl rather than switched to a ListBox: the row
                         buttons bind through $parent[ItemsControl], and changing the container type would
                         break every one of them. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobQueueRow">
                            <!-- .old dims a run that finished a while ago: history rather than news. The
                                 class is what the ten-minute mark does now that it no longer deletes. -->
                            <Border Classes="card" Classes.old="{Binding IsOld}"
                                    Margin="0,0,0,6" Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">

                                    <!-- Glyph + colour arrive as resource-key strings from the view model,
                                         resolved here — the same approach the activity and dry-run rows use,
                                         so the view model needs no Avalonia dependency. -->
                                    <PathIcon Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                              Width="16" Height="16" Margin="0,0,10,0"
                                              VerticalAlignment="Top"
                                              Data="{Binding StatusIconKey, Converter={x:Static conv:IconConverters.Geometry}}"
                                              Foreground="{Binding StatusColorKey, Converter={x:Static conv:IconConverters.Brush}}" />

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding StartedText}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding StatusText}" />
                                        </TextBlock>
                                        <TextBlock Classes="caption" Text="{Binding ProgressText}"
                                                   Foreground="{DynamicResource Brush.Info}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- Shown for every finished row, not just old ones. Runs are kept
                                             now, so "when" is as much a part of the row as "what". -->
                                        <TextBlock Classes="caption" Text="{Binding FinishedAgeText}"
                                                   IsVisible="{Binding HasFinishedAge}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Row actions. Pause and Cancel apply to a live run only; DISCARD
                                         applies to every row, because it is the only thing that removes a
                                         run — a finished one is otherwise kept until auto-delete reaps it,
                                         or forever when that setting is off. Discarding a live run confirms
                                         first (see JobQueueViewModel.ConfirmDiscard). -->
                                    <!-- Labelled and filled, like every other action in the app. Full-size
                                         rather than the dense 12px glyphs these were: the approval strip
                                         below the progress bar already puts full-size buttons inside this
                                         card, so a compact variant here would only make the two disagree.
                                         The profile name to the left already trims on overflow, which is
                                         what gives at the window's 520px minimum. -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                Spacing="8" VerticalAlignment="Top">
                                        <!-- Glyph AND label come from the row: this one button is both Pause
                                             and Resume, and PauseLabel already returns the word for the
                                             current state with notification wired to Paused. No tooltip —
                                             it used to hold this same word, and the header paragraph is
                                             where what pausing actually does is explained. -->
                                        <Button Classes="iconButton hasLabel" IsVisible="{Binding IsPausable}"
                                                Command="{Binding $parent[ItemsControl].((vm:JobQueueViewModel)DataContext).TogglePauseCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                                          Data="{Binding PauseIconKey, Converter={x:Static conv:IconConverters.Geometry}}" />
                                                <TextBlock Text="{Binding PauseLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="iconButton hasLabel" IsVisible="{Binding IsCancellable}"
                                                Command="{Binding $parent[ItemsControl].((vm:JobQueueViewModel)DataContext).CancelRunCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Cancel this run but keep it in the queue. Work that has not started is dropped; files already being copied finish. A Mirror run removes nothing.">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconSkip}" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="iconButton hasLabel tintDanger"
                                                Command="{Binding $parent[ItemsControl].((vm:JobQueueViewModel)DataContext).DiscardCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Discard — remove this run from the queue. A run still going is cancelled first.">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="Discard" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Margin="0,6,0,0" Height="4"
                                                 IsVisible="{Binding ShowProgress}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" />

                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                                IsVisible="{Binding IsAwaitingApproval}">
                                        <!-- A checkmark, not the Preview tab's play triangle: from here the
                                             plan is a summary rather than a report on screen, so this button
                                             reads as "yes, this one" rather than "watch it start". -->
                                        <Button Classes="iconButton hasLabel tintSuccess"
                                                IsVisible="{Binding CanApproveHere}"
                                                Command="{Binding $parent[ItemsControl].((vm:JobQueueViewModel)DataContext).ApproveCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Approve run — starts this run. It copies the files the plan listed and, for a Mirror profile, removes the ones marked for removal.">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconCheckmark}" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="Approve run" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- The spyglass the Profile tab's Preview uses: this goes and looks,
                                             it does not commit. -->
                                        <Button Classes="iconButton hasLabel"
                                                IsVisible="{Binding !CanApproveHere}"
                                                Command="{Binding $parent[ItemsControl].((vm:JobQueueViewModel)DataContext).ViewPlanCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Show what this run will do on the Preview tab, where it can be approved.">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="View plan…" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Declining a plan IS discarding it: the run closes AND leaves the
                                             queue, rather than lingering as a row for a plan the user said
                                             no to. Same command, and now the same trash can, as the row's
                                             discard button above. -->
                                        <Button Classes="iconButton hasLabel tintDanger"
                                                Command="{Binding $parent[ItemsControl].((vm:JobQueueViewModel)DataContext).DiscardCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Discard this plan. Nothing has been changed and nothing will be.">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="Discard" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>

</Window>

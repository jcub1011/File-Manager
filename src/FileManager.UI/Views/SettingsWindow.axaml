<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:st="using:FileManager.UI.ViewModels.Settings"
        xmlns:conv="using:FileManager.UI.Converters"
        xmlns:settings="using:FileManager.Contracts.Settings"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="FileManager.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="980" Height="680" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource Font.Body}"
        Background="{DynamicResource Brush.Window.Background}"
        Title="Settings"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <!--
      Visual Studio-style settings: a navigation tree and a search box on the left, a scrolling
      document of every setting on the right. Both panes are generated from the view model's catalog
      (SettingsViewModel.BuildCatalog) — there is one DataTemplate per *editor kind* below, not one per
      setting, so registering a new setting needs no change to this file unless it needs an editor kind
      that does not exist yet.

      Each setting renders as a Border.settingCard, which doubles as the scroll anchor the code-behind
      brings into view when a tree node is selected.
    -->
    <Window.DataTemplates>

        <!-- Pick-one-of-N (enum). Binds the non-generic base so the typed subclass stays a C# concern. -->
        <DataTemplate DataType="st:ChoiceSettingViewModel" x:DataType="st:ChoiceSettingViewModel">
            <Border Classes="settingCard" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}">
                <StackPanel Spacing="5">
                    <TextBlock Classes="settingTitle" Text="{Binding Title}" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                              MinWidth="260" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="st:ChoiceOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Description}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Free text, optionally read-only and optionally with a trailing action ("Browse…", "Change…"). -->
        <DataTemplate DataType="st:TextSettingViewModel" x:DataType="st:TextSettingViewModel">
            <Border Classes="settingCard" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}">
                <StackPanel Spacing="5">
                    <TextBlock Classes="settingTitle" Text="{Binding Title}" />
                    <!-- Star column, not a MinWidth: a path box has to give width back when the window
                         narrows, and this card cannot overflow (the document scrolls vertically only). -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}"
                                 PlaceholderText="{Binding PlaceholderText}" MinWidth="200" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding ActionButtonText}"
                                Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Description}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A number the engine can choose for you: while Auto is checked the spinner is hidden. -->
        <DataTemplate DataType="st:AutoNumberSettingViewModel" x:DataType="st:AutoNumberSettingViewModel">
            <Border Classes="settingCard" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}">
                <StackPanel Spacing="5">
                    <TextBlock Classes="settingTitle" Text="{Binding Title}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox Content="Auto" IsChecked="{Binding Auto}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Value}" Minimum="{Binding Minimum}" Width="160"
                                       FormatString="0" IsVisible="{Binding ShowValue}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Description}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- On/off. Unused by the current catalog; here so the first boolean setting needs no XAML. -->
        <DataTemplate DataType="st:BoolSettingViewModel" x:DataType="st:BoolSettingViewModel">
            <Border Classes="settingCard" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}">
                <StackPanel Spacing="5">
                    <TextBlock Classes="settingTitle" Text="{Binding Title}" />
                    <CheckBox Content="{Binding CheckBoxLabel}" IsChecked="{Binding Value}" HorizontalAlignment="Left" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Description}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A setting whose editor is two editable lists — the worked example of a bespoke editor:
             derive from SettingItemViewModel, add one template here, and search / tree navigation /
             scroll anchoring all keep working. -->
        <DataTemplate DataType="st:DriveOverridesSettingViewModel" x:DataType="st:DriveOverridesSettingViewModel">
            <Border Classes="settingCard" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="settingTitle" Text="{Binding Title}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Description}" />

                    <TextBlock Classes="fieldLabel" Text="Drive-type overrides" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding DriveTypeOverrides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="st:DriveTypeOverrideRowViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" Margin="0,2">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding Options}" SelectedItem="{Binding Class}" MinWidth="160">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="settings:DriveClass">
                                                <TextBlock Text="{Binding Converter={x:Static conv:EnumTitleConverters.DriveClass}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Grid.Column="1" Content="Auto" IsChecked="{Binding Auto}" Margin="10,0" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding Value}" Minimum="1" Width="130" FormatString="0"
                                                   VerticalAlignment="Center" IsVisible="{Binding ShowValue}" />
                                    <Button Grid.Column="3" Content="Remove" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((st:DriveOverridesSettingViewModel)DataContext).RemoveDriveTypeOverrideCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add drive-type override" Command="{Binding AddDriveTypeOverrideCommand}" HorizontalAlignment="Left" />

                    <TextBlock Classes="fieldLabel" Text="Specific-drive overrides" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding SpecificDriveOverrides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="st:SpecificDriveOverrideRowViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" Margin="0,2">
                                    <TextBox Grid.Column="0" Text="{Binding VolumeKey}" PlaceholderText="c: or \\server\share" MinWidth="160" />
                                    <CheckBox Grid.Column="1" Content="Auto" IsChecked="{Binding Auto}" Margin="10,0" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding Value}" Minimum="1" Width="130" FormatString="0"
                                                   VerticalAlignment="Center" IsVisible="{Binding ShowValue}" />
                                    <Button Grid.Column="3" Content="Remove" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((st:DriveOverridesSettingViewModel)DataContext).RemoveSpecificDriveOverrideCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add drive override" Command="{Binding AddSpecificDriveOverrideCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel LastChildFill="True">

        <!-- Custom title bar, same recipe as MainWindow: the OS keeps the resizable frame but draws no
             system caption, so the bar follows the app theme instead of the Windows default. The
             ElementRole markers are load-bearing — TitleBar makes the grid the drag region, and the close
             button needs its own role or the drag region swallows its clicks. -->
        <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="Auto,*,Auto"
              Background="{DynamicResource Brush.Chrome.Background}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource Brush.Accent}">
                    <PathIcon Data="{StaticResource IconGear}" Width="11" Height="11" Foreground="White" />
                </Border>
                <TextBlock Text="Settings" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="{StaticResource Font.Title}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
            </StackPanel>

            <Button Grid.Column="2" Classes="caption close"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                    Click="OnCloseClick" ToolTip.Tip="Close">
                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Footer: pinned so Save and any message stay visible no matter how far the document scrolls. -->
        <Border DockPanel.Dock="Bottom" Padding="16,10"
                Background="{DynamicResource Brush.Chrome.Background}"
                BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <Border Classes="infoBar danger"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Classes="infoBar success"
                        IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Close" Click="OnCloseClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="260,Auto,*">

            <!-- Navigation pane: search filters both this tree and the document beside it. -->
            <Border Grid.Column="0" Padding="10"
                    Background="{DynamicResource Brush.Panel.Background}"
                    BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="0,0,0,8"
                             Text="{Binding SearchText}" PlaceholderText="Search settings (Ctrl+F)">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                                      Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <TreeView Classes="settingsNav" ItemsSource="{Binding NavNodes}"
                                  SelectedItem="{Binding SelectedNavNode, Mode=TwoWay}">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="st:SettingsNavNodeViewModel" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns" />

            <!-- The document. SettingsHost is searched by the code-behind for the anchor to scroll to.
                 The inset is the content's Margin, NOT the ScrollViewer's Padding: Padding is measured
                 into the extent but not out of the child's available width, so the settings (and their
                 selection highlight) would run past the right edge and be clipped. -->
            <ScrollViewer Grid.Column="2" x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled">
                <!-- The readable-width cap lives here, as a MaxWidth on a star COLUMN, so it is applied
                     once for every setting. Putting MaxWidth on the settings themselves centres them in
                     the leftover space (that is what Stretch + MaxWidth does), which reads as the content
                     drifting away from the left edge as the window widens. A capped star column keeps
                     everything anchored left and simply leaves the surplus width empty. -->
                <Grid Margin="16,4,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="900" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ItemsControl x:Name="SettingsHost" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="st:SettingsCategoryViewModel">
                                    <StackPanel IsVisible="{Binding IsVisible}">
                                        <Border Classes="sectionHeader"><TextBlock Text="{Binding HeaderText}" /></Border>
                                        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="9,0,0,8"
                                                   Text="{Binding Description}"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <!-- No ItemTemplate: each setting picks up the per-kind template above. -->
                                        <ItemsControl ItemsSource="{Binding Items}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="10" Margin="9,24,0,0" HorizontalAlignment="Left"
                                    IsVisible="{Binding !HasVisibleSettings}">
                            <TextBlock Classes="secondary" Text="No settings match your search." />
                            <Button Content="Clear search" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Trailing space so the last setting can still be scrolled up to the top of the
                             viewport when the navigation tree jumps to it. -->
                        <Border Height="240" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>

</Window>

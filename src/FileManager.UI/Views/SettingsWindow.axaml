<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:conv="using:FileManager.UI.Converters"
        xmlns:settings="using:FileManager.Contracts.Settings"
        xmlns:prof="using:FileManager.Contracts.Profiles"
        x:Class="FileManager.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource Font.Body}"
        Background="{DynamicResource Brush.Window.Background}"
        Title="Settings">

    <StackPanel Margin="16" Spacing="4">
        <Border Classes="sectionHeader" Margin="0,0,0,8"><TextBlock Text="Service startup" /></Border>
        <TextBlock TextWrapping="Wrap" Classes="secondary" Margin="0,0,0,8"
                   Text="When the background service runs. RunOnStartup launches it at Windows login. StartOnProgramOpen starts it when this app opens and leaves it running. StartAndStopWithProgram starts it on open and stops it when the app closes (warning first if jobs are running)." />

        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" Margin="0,0,0,4">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Startup mode" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ServiceStartupModeOptions}"
                      SelectedItem="{Binding StartupMode}" Margin="0,2" MinWidth="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="settings:ServiceStartupMode">
                        <TextBlock Text="{Binding Converter={x:Static conv:EnumTitleConverters.ServiceStartupMode}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Classes="sectionHeader"><TextBlock Text="Dry-run performance" /></Border>
        <TextBlock TextWrapping="Wrap" Classes="secondary" Margin="0,0,0,8"
                   Text="How many files a dry run evaluates in parallel. Automatic reserves one core for the system (capped at 8). Individual profiles can override this." />

        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Concurrency" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ConcurrencyModeOptions}"
                      SelectedItem="{Binding Mode}" Margin="0,2" MinWidth="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="prof:ConcurrencyMode">
                        <TextBlock Text="{Binding Converter={x:Static conv:EnumTitleConverters.ConcurrencyMode}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Worker count"
                       IsVisible="{Binding ShowManualWorkers}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ManualWorkers}" Minimum="1"
                           Width="220" HorizontalAlignment="Left" Margin="0,2" FormatString="0"
                           IsVisible="{Binding ShowManualWorkers}" />
        </Grid>

        <Border Classes="infoBar danger" Margin="0,8,0,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="infoBar success" Margin="0,8,0,0"
                IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsEnabled="{Binding !IsBusy}" />
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>

</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             x:Class="FileManager.UI.Views.DryRunView"
             x:DataType="vm:DryRunViewModel">

    <UserControl.Resources>
        <!-- Shared tree row for both the Sources and Destinations trees. The built-in TreeView draws
             the expand chevron + indentation; we supply the node name (col 0) and a right-aligned strip
             of rolled-up, colour-coded summary pills (col 1). ItemsSource="{Binding Children}" makes it
             hierarchical. The pills are data-driven (each carries its own brushes) so one template
             serves both tabs. -->
        <TreeDataTemplate x:Key="DryRunNodeTemplate" x:DataType="vm:DryRunTreeNode"
                          ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="*,Auto" Height="24">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas,monospace"
                           VerticalAlignment="Center" Classes.dir="{Binding IsDirectory}"
                           TextTrimming="CharacterEllipsis" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Pills}" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TreePill">
                            <Border CornerRadius="10" Padding="10,3" Background="{Binding Background}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Foreground}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </TreeDataTemplate>

        <!-- A tab's source + destination filter facets: two WrapPanels of checkboxes. -->
        <DataTemplate x:Key="FacetTemplate" x:DataType="vm:DryRunFacetRow">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                      Content="{Binding Label}" ToolTip.Tip="{Binding Key}" />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>
        <Style Selector="Border.chipDanger">
            <Setter Property="Background" Value="#E53935" />
        </Style>
        <Style Selector="Border.chipDanger TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.chipAmber">
            <Setter Property="Background" Value="#FFA000" />
        </Style>
        <Style Selector="Border.chipAmber TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Border.chipSafe">
            <Setter Property="Background" Value="#2E7D32" />
        </Style>
        <Style Selector="Border.chipSafe TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.chipMuted">
            <Setter Property="Background" Value="#757575" />
        </Style>
        <Style Selector="Border.chipMuted TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Untouched pill: blue, distinct from the green "will change" pills. -->
        <Style Selector="Border.chipInfo">
            <Setter Property="Background" Value="#1E88E5" />
        </Style>
        <Style Selector="Border.chipInfo TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- per-target kind tags (Sources list nested targets) -->
        <Style Selector="TextBlock.kind">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.kind.overwrite">
            <Setter Property="Foreground" Value="#E53935" />
        </Style>
        <Style Selector="TextBlock.kind.rename">
            <Setter Property="Foreground" Value="#FFA000" />
        </Style>
        <Style Selector="TextBlock.kind.write">
            <Setter Property="Foreground" Value="#2E7D32" />
        </Style>
        <Style Selector="TextBlock.kind.skip">
            <Setter Property="Foreground" Value="#9E9E9E" />
        </Style>
        <Style Selector="TextBlock.kind.unknown">
            <Setter Property="Foreground" Value="#8E24AA" />
        </Style>

        <!-- Virtualized row lists: strip default ListBoxItem chrome so rows render like plain rows. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="TextBlock.dir">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Virtualized tree lists (recycle containers per level so a large forest stays bounded). -->
        <Style Selector="TreeView.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TreeView.rows TreeViewItem" x:DataType="vm:DryRunTreeNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- controls row: the dry run always simulates every Source (the complete blast radius,
             spec §8); the user narrows the *view* with the per-tab source/destination facets below. -->
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <Button Grid.Column="1" Content="Run dry run" Classes="accent"
                        Command="{Binding RunCommand}" />
                <Button Grid.Column="2" Content="Cancel" Margin="6,0,0,0"
                        Command="{Binding RunCancelCommand}"
                        IsVisible="{Binding RunCommand.IsRunning}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding RunCommand.IsRunning}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53935" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Grid Margin="0,8,0,0" IsVisible="{Binding HasReport}" RowDefinitions="Auto,Auto,*">

            <!-- truncation notice -->
            <Border Grid.Row="0" Classes="chipAmber" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                    IsVisible="{Binding WasTruncated}">
                <TextBlock Text="{Binding TruncationNotice}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- blast-radius banner -->
            <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="Bold" Text="Blast radius" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GeneratedAtText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel>
                        <Border Classes="chip" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding TotalFiles}" /><Run Text=" files scanned" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipDanger" Margin="0,0,6,0" IsVisible="{Binding !!OverwriteCount}">
                            <TextBlock><Run Text="{Binding OverwriteCount}" /><Run Text=" OVERWRITES" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipAmber" Margin="0,0,6,0" IsVisible="{Binding !!RenameCount}">
                            <TextBlock><Run Text="{Binding RenameCount}" /><Run Text=" renames" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipDanger" Margin="0,0,6,0" IsVisible="{Binding !!DisposalCount}">
                            <TextBlock><Run Text="{Binding DisposalCount}" /><Run Text=" source disposals" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipSafe" Margin="0,0,6,0" IsVisible="{Binding !HasDestructiveActions}">
                            <TextBlock Text="no destructive actions" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="2">

                <!-- ============================= SOURCES ============================= -->
                <TabItem Header="Sources">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">

                        <!-- summary pills (whole-run counts) -->
                        <WrapPanel Grid.Row="0">
                            <Border Classes="chip chipInfo" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Sources.UntouchedCount}" /><Run Text=" untouched" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipSafe" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Sources.ProcessedCount}" /><Run Text=" processed" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipDanger" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Sources.DeletedCount}" /><Run Text=" deleted" /></TextBlock>
                            </Border>
                        </WrapPanel>

                        <!-- source + destination facets -->
                        <StackPanel Grid.Row="1" Spacing="6">
                            <Border IsVisible="{Binding Sources.ShowSourceFacet}"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                    CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Sources:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Sources.SourceFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border IsVisible="{Binding Sources.ShowDestinationFacet}"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                    CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Destinations:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Sources.DestinationFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="Source files (" /><Run Text="{Binding Sources.VisibleRows.Count}" /><Run Text=")" />
                            </TextBlock>
                            <ToggleButton Grid.Column="2" Content="Tree view" IsChecked="{Binding Sources.ShowTree}"
                                          FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ToolTip.Tip="Group the files into a navigable directory tree" />
                            <TextBox Grid.Column="3" Width="280" Text="{Binding Sources.SearchText}"
                                     PlaceholderText="Filter by source or target path…" />
                        </Grid>

                        <ListBox Grid.Row="3" Classes="rows" ItemsSource="{Binding Sources.VisibleRows}"
                                 IsVisible="{Binding !Sources.ShowTree}"
                                 SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DryRunFileRow">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                                            Padding="4,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3" Opacity="{Binding ContentOpacity}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SourcePath}" FontFamily="Consolas,monospace"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                                    <TextBlock Classes="kind overwrite" Text="{Binding SourceDisposition}"
                                                               IsVisible="{Binding IsSourceDisposalDestructive}" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Targets}" Margin="18,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DryRunTargetRow">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="kind" Text="{Binding KindText}" MinWidth="110"
                                                                           Classes.overwrite="{Binding IsOverwrite}"
                                                                           Classes.rename="{Binding IsRename}"
                                                                           Classes.write="{Binding IsWrite}"
                                                                           Classes.skip="{Binding IsSkip}"
                                                                           Classes.unknown="{Binding IsUnknown}" />
                                                                <TextBlock Text="{Binding Path}" FontFamily="Consolas,monospace" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="520" Opacity="0.85" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- right-aligned pills; a processed-and-deleted file shows both -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border Classes="chip chipInfo" IsVisible="{Binding IsUntouched}">
                                                    <TextBlock Text="Untouched" FontSize="11" />
                                                </Border>
                                                <Border Classes="chip chipSafe" IsVisible="{Binding IsProcessed}">
                                                    <TextBlock Text="Processed" FontSize="11" />
                                                </Border>
                                                <Border Classes="chip chipDanger" IsVisible="{Binding IsDeleted}">
                                                    <TextBlock Text="Deleted" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TreeView Grid.Row="3" Classes="rows" ItemsSource="{Binding Sources.Tree}"
                                  IsVisible="{Binding Sources.ShowTree}"
                                  ItemTemplate="{StaticResource DryRunNodeTemplate}" />
                    </Grid>
                </TabItem>

                <!-- ============================ DESTINATIONS ============================ -->
                <TabItem Header="Destinations">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">

                        <WrapPanel Grid.Row="0">
                            <Border Classes="chip chipInfo" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Destinations.UntouchedCount}" /><Run Text=" untouched" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipSafe" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Destinations.NewCount}" /><Run Text=" new" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipAmber" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Destinations.OverwrittenCount}" /><Run Text=" overwritten" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipDanger" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding Destinations.DeletedCount}" /><Run Text=" deleted" /></TextBlock>
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <Border IsVisible="{Binding Destinations.ShowSourceFacet}"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                    CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Sources:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Destinations.SourceFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border IsVisible="{Binding Destinations.ShowDestinationFacet}"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                    CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Destinations:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Destinations.DestinationFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="Destination files (" /><Run Text="{Binding Destinations.VisibleRows.Count}" /><Run Text=")" />
                            </TextBlock>
                            <ToggleButton Grid.Column="2" Content="Tree view" IsChecked="{Binding Destinations.ShowTree}"
                                          FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ToolTip.Tip="Group the resulting files into a navigable directory tree" />
                            <TextBox Grid.Column="3" Width="280" Text="{Binding Destinations.SearchText}"
                                     PlaceholderText="Filter by destination or source path…" />
                        </Grid>

                        <ListBox Grid.Row="3" Classes="rows" ItemsSource="{Binding Destinations.VisibleRows}"
                                 IsVisible="{Binding !Destinations.ShowTree}"
                                 SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DryRunDestinationRow">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                                            Padding="4,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Text="{Binding TargetPath}" FontFamily="Consolas,monospace"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="18,0,0,0">
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                               IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <TextBlock Text="{Binding SourceRoot}" FontSize="11" Opacity="0.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                                               IsVisible="{Binding HasSource}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Classes.chipInfo="{Binding IsUntouched}"
                                                    Classes.chipSafe="{Binding IsNew}"
                                                    Classes.chipAmber="{Binding IsOverwritten}"
                                                    Classes.chipDanger="{Binding IsDeleted}"
                                                    Classes.chipMuted="{Binding IsUnknown}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TreeView Grid.Row="3" Classes="rows" ItemsSource="{Binding Destinations.Tree}"
                                  IsVisible="{Binding Destinations.ShowTree}"
                                  ItemTemplate="{StaticResource DryRunNodeTemplate}" />
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>

</UserControl>

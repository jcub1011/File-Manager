<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             x:Class="FileManager.UI.Views.DryRunView"
             x:DataType="vm:DryRunViewModel">

    <UserControl.Resources>
        <!-- Shared tree row for the merged "Affected files" TreeView. The built-in TreeView draws the
             expand chevron + indentation; we supply the node name (col 0) and a right-aligned strip of
             status + danger chips (col 1). ItemsSource="{Binding Children}" is what makes it hierarchical. -->
        <TreeDataTemplate x:Key="DryRunNodeTemplate" x:DataType="vm:DryRunTreeNode"
                          ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="*,Auto" Height="24">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas,monospace"
                           VerticalAlignment="Center" Classes.dir="{Binding IsDirectory}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- status rollups, in the requested order: Unchanged, Skipped, Processed -->
                    <Border Classes="chip chipAccent" IsVisible="{Binding HasUnchanged}">
                        <TextBlock Text="{Binding UnchangedText}" FontSize="11" />
                    </Border>
                    <Border Classes="chip chipMuted" IsVisible="{Binding HasFiltered}">
                        <TextBlock Text="{Binding FilteredText}" FontSize="11" />
                    </Border>
                    <Border Classes="chip chipSafe" IsVisible="{Binding HasProcessed}">
                        <TextBlock Text="{Binding ProcessedText}" FontSize="11" />
                    </Border>
                    <!-- secondary danger rollups -->
                    <Border Classes="chip chipDanger" IsVisible="{Binding HasOverwrites}">
                        <TextBlock Text="{Binding OverwriteText}" FontSize="11" />
                    </Border>
                    <Border Classes="chip chipAmber" IsVisible="{Binding HasRenames}">
                        <TextBlock Text="{Binding RenameText}" FontSize="11" />
                    </Border>
                    <Border Classes="chip chipDanger" IsVisible="{Binding HasDisposals}">
                        <TextBlock Text="{Binding DisposalText}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>
        </TreeDataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>
        <Style Selector="Border.chipDanger">
            <Setter Property="Background" Value="#E53935" />
        </Style>
        <Style Selector="Border.chipDanger TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.chipAmber">
            <Setter Property="Background" Value="#FFA000" />
        </Style>
        <Style Selector="Border.chipAmber TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Border.chipSafe">
            <Setter Property="Background" Value="#2E7D32" />
        </Style>
        <Style Selector="Border.chipSafe TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Skipped-by-filter pill: a muted grey, reads as "excluded, nothing happens". -->
        <Style Selector="Border.chipMuted">
            <Setter Property="Background" Value="#757575" />
        </Style>
        <Style Selector="Border.chipMuted TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Unchanged pill: the theme accent, distinct from the safe/green "will change" pill. -->
        <Style Selector="Border.chipAccent">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.chipAccent TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- per-target kind tags -->
        <Style Selector="TextBlock.kind">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.kind.overwrite">
            <Setter Property="Foreground" Value="#E53935" />
        </Style>
        <Style Selector="TextBlock.kind.rename">
            <Setter Property="Foreground" Value="#FFA000" />
        </Style>
        <Style Selector="TextBlock.kind.write">
            <Setter Property="Foreground" Value="#2E7D32" />
        </Style>
        <Style Selector="TextBlock.kind.skip">
            <Setter Property="Foreground" Value="#9E9E9E" />
        </Style>
        <Style Selector="TextBlock.kind.unknown">
            <Setter Property="Foreground" Value="#8E24AA" />
        </Style>

        <!-- Virtualized row lists: strip the default ListBoxItem chrome so rows render exactly like
             the old ItemsControl rows (the item templates supply their own padding/borders). -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- directory node names in the tree view -->
        <Style Selector="TextBlock.dir">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Virtualized tree lists. A VirtualizingStackPanel on both the TreeView and each TreeViewItem
             makes the built-in control recycle containers per level instead of realizing every node, so
             a 50k-file forest stays bounded (matching the ListBox virtualization the flat views rely on). -->
        <Style Selector="TreeView.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <!-- x:DataType lets the IsExpanded setter bind (two-way) against the node so the default-expanded
             roots open on load and user expand/collapse round-trips into the model. -->
        <Style Selector="TreeView.rows TreeViewItem" x:DataType="vm:DryRunTreeNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- controls row: the dry run always simulates every Source (the complete blast radius,
             spec §8); the user narrows the *view* with the source facet and filters below. -->
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <Button Grid.Column="1" Content="Run dry run" Classes="accent"
                        Command="{Binding RunCommand}" />
                <Button Grid.Column="2" Content="Cancel" Margin="6,0,0,0"
                        Command="{Binding RunCancelCommand}"
                        IsVisible="{Binding RunCommand.IsRunning}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding RunCommand.IsRunning}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53935" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Bounded layout: the * row is bounded by the fixed-size window, which is what lets the
             detail lists virtualize. The old outer ScrollViewer+StackPanel handed each list an
             infinite height, defeating virtualization and materializing all 50k rows at once. -->
        <Grid Margin="0,8,0,0" IsVisible="{Binding HasReport}" RowDefinitions="Auto,Auto,*">

                <!-- truncation notice -->
                <Border Grid.Row="0" Classes="chipAmber" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                        IsVisible="{Binding WasTruncated}">
                    <TextBlock Text="{Binding TruncationNotice}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- blast-radius banner -->
                <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontWeight="Bold" Text="Blast radius" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GeneratedAtText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel>
                            <Border Classes="chip" Margin="0,0,6,0">
                                <TextBlock><Run Text="{Binding TotalFiles}" /><Run Text=" files scanned" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipDanger" Margin="0,0,6,0" IsVisible="{Binding !!OverwriteCount}">
                                <TextBlock><Run Text="{Binding OverwriteCount}" /><Run Text=" OVERWRITES" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipAmber" Margin="0,0,6,0" IsVisible="{Binding !!RenameCount}">
                                <TextBlock><Run Text="{Binding RenameCount}" /><Run Text=" renames" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipDanger" Margin="0,0,6,0" IsVisible="{Binding !!DisposalCount}">
                                <TextBlock><Run Text="{Binding DisposalCount}" /><Run Text=" source disposals" /></TextBlock>
                            </Border>
                            <Border Classes="chip chipSafe" Margin="0,0,6,0" IsVisible="{Binding !HasDestructiveActions}">
                                <TextBlock Text="no destructive actions" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- detail area: one merged "Affected files" list/tree fills the bounded * region so it
                     virtualizes. Disposition filter pills above it narrow which statuses are shown. -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">

                    <!-- source focus facet: filters which sources' rows are shown (multi-source
                         reports only). It never changes the blast-radius banner above, which always
                         reflects the complete run. -->
                    <Border Grid.Row="0" IsVisible="{Binding ShowSourceFacet}"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                            CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Sources:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding SourceFacets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SourceFacetRow">
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                                                  Content="{Binding Label}"
                                                  ToolTip.Tip="{Binding Root}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- disposition filter pills. The primary pills start selected and "Destructive" off;
                         toggling any narrows the merged list/tree. "Would process" and "Destructive" are
                         mutually exclusive views of the processed rows (all vs the risky subset). -->
                    <WrapPanel Grid.Row="1">
                        <ToggleButton IsChecked="{Binding ShowProcessed}" FontSize="12" Margin="0,0,6,0">
                            <TextBlock><Run Text="Would process (" /><Run Text="{Binding ProcessCount}" /><Run Text=")" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowDestructive}" FontSize="12" Margin="0,0,6,0"
                                      ToolTip.Tip="Show only the processed rows with overwrites or disposals">
                            <TextBlock><Run Text="Destructive (" /><Run Text="{Binding DestructiveCount}" /><Run Text=")" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowFiltered}" FontSize="12" Margin="0,0,6,0">
                            <TextBlock><Run Text="Filtered out (" /><Run Text="{Binding FilterSkipCount}" /><Run Text=")" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowUnchanged}" FontSize="12" Margin="0,0,6,0">
                            <TextBlock><Run Text="Unchanged (" /><Run Text="{Binding UnchangedSkipCount}" /><Run Text=")" /></TextBlock>
                        </ToggleButton>
                    </WrapPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="Affected files (" /><Run Text="{Binding AffectedFiles.Count}" /><Run Text=")" />
                        </TextBlock>
                        <ToggleButton Grid.Column="2" Content="Tree view" IsChecked="{Binding ShowTree}"
                                      FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                      ToolTip.Tip="Group the files into a navigable directory tree" />
                        <TextBox Grid.Column="3" Width="280" Text="{Binding SearchText}"
                                 PlaceholderText="Filter by source or target path…" />
                    </Grid>

                    <ListBox Grid.Row="3" Classes="rows" ItemsSource="{Binding AffectedFiles}"
                             IsVisible="{Binding !ShowTree}"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DryRunFileRow">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                                        Padding="4,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- row content: dimmed for filter-skipped rows; the pill (col 1) is not -->
                                        <StackPanel Grid.Column="0" Spacing="3" Opacity="{Binding ContentOpacity}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SourcePath}" FontFamily="Consolas,monospace"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                                <TextBlock Classes="kind overwrite" Text="{Binding SourceDisposition}"
                                                           IsVisible="{Binding IsSourceDisposalDestructive}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Targets}" Margin="18,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DryRunTargetRow">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="kind" Text="{Binding KindText}" MinWidth="110"
                                                                       Classes.overwrite="{Binding IsOverwrite}"
                                                                       Classes.rename="{Binding IsRename}"
                                                                       Classes.write="{Binding IsWrite}"
                                                                       Classes.skip="{Binding IsSkip}"
                                                                       Classes.unknown="{Binding IsUnknown}" />
                                                            <TextBlock Text="{Binding Path}" FontFamily="Consolas,monospace" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="520" Opacity="0.85" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- right-aligned status pill; stays fully legible (outside the dimmed column) -->
                                        <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Classes.chipSafe="{Binding IsProcessed}"
                                                Classes.chipMuted="{Binding IsFilterSkipped}"
                                                Classes.chipAccent="{Binding IsUnchangedSkipped}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- tree view: the same visible set as a navigable directory tree, using the built-in
                         TreeView. Only expanded nodes' children are realized, and the VirtualizingStackPanel
                         recycles rows, so a large forest stays bounded. -->
                    <TreeView Grid.Row="3" Classes="rows" ItemsSource="{Binding AffectedTree}"
                              IsVisible="{Binding ShowTree}"
                              ItemTemplate="{StaticResource DryRunNodeTemplate}" />

                </Grid>
        </Grid>
    </DockPanel>

</UserControl>

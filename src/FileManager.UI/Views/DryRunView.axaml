<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             xmlns:ctrl="using:FileManager.UI.Controls"
             x:Class="FileManager.UI.Views.DryRunView"
             x:DataType="vm:DryRunViewModel">

    <UserControl.Resources>
        <!-- Shared cell templates for both the Sources and Destinations trees (rendered by
             TreeDataGrid, which flattens the hierarchy into a single virtualized row list). The
             expander column draws the chevron + indentation; these templates supply the node name and
             a strip of rolled-up, colour-coded summary pills. The pills are data-driven (each carries
             its own brushes) so one template serves both tabs. -->
        <DataTemplate x:Key="DryRunNameCell" x:DataType="vm:DryRunTreeNode">
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}"
                       VerticalAlignment="Center" Classes.dir="{Binding IsDirectory}"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
        </DataTemplate>
        <DataTemplate x:Key="DryRunPillsCell" x:DataType="vm:DryRunTreeNode">
            <ItemsControl ItemsSource="{Binding Pills}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreePill">
                        <Border CornerRadius="10" Padding="10,3" Background="{Binding Background}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Foreground}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- A tab's source + destination filter facets: two WrapPanels of checkboxes. -->
        <DataTemplate x:Key="FacetTemplate" x:DataType="vm:DryRunFacetRow">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                      Content="{Binding Label}" ToolTip.Tip="{Binding Key}" />
        </DataTemplate>

        <!-- One destination volume: header (root + settled used/free), the nested-increment storage
             bar, a details line, an optional warning, and an optional per-target-root drill-down. -->
        <DataTemplate x:Key="VolumeSpaceTemplate" x:DataType="vm:VolumeSpaceRow">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                    Padding="0,6">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding VolumeRoot}" FontWeight="SemiBold"
                                   FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="11" Opacity="0.7" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" IsVisible="{Binding CapacityKnown}"
                                   ToolTip.Tip="The drive's state right now, before this run makes any changes">
                            <Run Text="(Current Status) " /><Run Text="{Binding UsedNowText}" /><Run Text=" used · " /><Run Text="{Binding CurrentFreeText}" /><Run Text=" free of " /><Run Text="{Binding CapacityText}" />
                        </TextBlock>
                    </Grid>

                    <ctrl:StorageBar Height="20" IsVisible="{Binding CapacityKnown}"
                                     CapacityBytes="{Binding CapacityBytes}" UsedNowBytes="{Binding UsedNowBytes}"
                                     SettledBytes="{Binding SettledBytes}" RealisticPeakBytes="{Binding RealisticPeakBytes}"
                                     SafeCeilingBytes="{Binding SafeCeilingBytes}" MarginBytes="{Binding MarginBytes}" />

                    <TextBlock IsVisible="{Binding !CapacityKnown}" FontSize="11" Opacity="0.7"
                               Text="Free space could not be determined for this volume." />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontSize="11" Opacity="0.7" ToolTip.Tip="Realistic Peak Storage Usage">
                            <Run Text="RPSU " /><Run Text="{Binding PeakText}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.4" Text="·" />
                        <TextBlock FontSize="11" Opacity="0.7" ToolTip.Tip="Absolute Peak Storage Usage">
                            <Run Text="APSU " /><Run Text="{Binding CeilingText}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.4" Text="·" />
                        <TextBlock FontSize="11" Opacity="0.7">
                            <Run Text="Data Written " /><Run Text="{Binding WrittenText}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.4" Text="·" />
                        <TextBlock FontSize="11" Opacity="0.7" ToolTip.Tip="Storage Used At Rest">
                            <Run Text="SUAR " /><Run Text="{Binding SettledUsedText}" />
                        </TextBlock>
                    </StackPanel>

                    <Border Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding HasWarning}"
                            Classes.chipDanger="{Binding IsDanger}" Classes.chipAmber="{Binding IsWarning}">
                        <TextBlock Text="{Binding WarningText}" FontSize="11" />
                    </Border>

                    <Expander IsVisible="{Binding HasFolders}" Header="By folder" Padding="0" Margin="0,2,0,0">
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderSpaceRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Root}" FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Root}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileCountText}" FontSize="11" Opacity="0.6" Margin="12,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding WrittenText}" FontSize="11" Margin="12,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding NetChangeText}" FontSize="11" Opacity="0.8" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- chip* and kind* classes are shared app-wide in Themes/Controls.axaml (token-backed). -->

        <!-- Virtualized row lists: strip default ListBoxItem chrome so rows render like plain rows. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="TextBlock.dir">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- The tree lists render with TreeDataGrid, which flattens the hierarchy into one virtualized
             row list (only visible rows are realized, however deep or expanded the forest). Keep the
             surface clean: transparent, borderless, compact rows to match the rest of the panel. -->
        <Style Selector="TreeDataGrid.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowColumnHeaders" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
        </Style>
        <Style Selector="TreeDataGrid.rows TreeDataGridRow">
            <Setter Property="MinHeight" Value="24" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- controls row: the dry run always simulates every Source (the complete blast radius,
             spec §8); the user narrows the *view* with the per-tab source/destination facets below. -->
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <Button Grid.Column="1" Content="Run dry run" Classes="accent"
                        Command="{Binding RunCommand}" />
                <Button Grid.Column="2" Content="Cancel" Margin="6,0,0,0"
                        Command="{Binding RunCancelCommand}"
                        IsVisible="{Binding RunCommand.IsRunning}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding RunCommand.IsRunning}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Grid Margin="0,8,0,0" IsVisible="{Binding HasReport}" RowDefinitions="Auto,Auto,Auto,*">

            <!-- truncation notice -->
            <Border Grid.Row="0" Classes="chipAmber" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                    IsVisible="{Binding WasTruncated}">
                <TextBlock Text="{Binding TruncationNotice}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- blast-radius banner -->
            <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="Bold" Text="Blast radius" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GeneratedAtText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel>
                        <Border Classes="chip" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding TotalFiles}" /><Run Text=" files scanned" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipDanger" Margin="0,0,6,0" IsVisible="{Binding !!OverwriteCount}">
                            <TextBlock><Run Text="{Binding OverwriteCount}" /><Run Text=" OVERWRITES" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipAmber" Margin="0,0,6,0" IsVisible="{Binding !!RenameCount}">
                            <TextBlock><Run Text="{Binding RenameCount}" /><Run Text=" renames" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipDanger" Margin="0,0,6,0" IsVisible="{Binding !!DisposalCount}">
                            <TextBlock><Run Text="{Binding DisposalCount}" /><Run Text=" source disposals" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipSafe" Margin="0,0,6,0" IsVisible="{Binding !HasDestructiveActions}">
                            <TextBlock Text="no destructive actions" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- storage / space preview: per-volume used·free·bounded-maximum, with a per-folder
                 drill-down. Hidden when no projection was computed (truncated report, or volumes that
                 could not be resolved). -->
            <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="6" Padding="10" Margin="0,0,0,8"
                    IsVisible="{Binding Space, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontWeight="Bold" Text="Storage" VerticalAlignment="Center" />
                        <Border Classes="chip" Margin="6,0,0,0">
                            <TextBlock><Run Text="{Binding Space.TransferredText}" /><Run Text=" to transfer" /></TextBlock>
                        </Border>
                        <Border Classes="chip">
                            <TextBlock><Run Text="{Binding Space.NetChangeText}" /><Run Text=" net change" /></TextBlock>
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Space.Volumes}" ItemTemplate="{StaticResource VolumeSpaceTemplate}" />
                </StackPanel>
            </Border>

            <!-- Sources and Destinations side by side (draggable split) so the whole picture is
                 visible at once. Paths are shown relative to each panel's common root to reclaim the
                 horizontal space that repeated drive prefixes used to waste. -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- ============================= SOURCES ============================= -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8" Margin="0,8,8,0">

                    <TextBlock Grid.Row="0" Text="Sources" FontWeight="Bold" FontSize="14" />

                    <!-- what the paths below are relative to -->
                    <TextBlock Grid.Row="1" Text="{Binding Sources.CommonRootDisplay}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Sources.CommonRoot}" />

                    <!-- summary pills (whole-run counts) -->
                    <WrapPanel Grid.Row="2">
                        <Border Classes="chip chipInfo" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Sources.UntouchedCount}" /><Run Text=" untouched" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipSafe" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Sources.ProcessedCount}" /><Run Text=" processed" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipDanger" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Sources.DeletedCount}" /><Run Text=" deleted" /></TextBlock>
                        </Border>
                    </WrapPanel>

                    <!-- source + destination facets -->
                    <StackPanel Grid.Row="3" Spacing="6">
                        <Border IsVisible="{Binding Sources.ShowSourceFacet}"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="6" Padding="10,6">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Sources:" FontWeight="SemiBold" VerticalAlignment="Center"
                                           DockPanel.Dock="Left" Margin="0,0,8,0" />
                                <ItemsControl ItemsSource="{Binding Sources.SourceFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <Border IsVisible="{Binding Sources.ShowDestinationFacet}"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="6" Padding="10,6">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Destinations:" FontWeight="SemiBold" VerticalAlignment="Center"
                                           DockPanel.Dock="Left" Margin="0,0,8,0" />
                                <ItemsControl ItemsSource="{Binding Sources.DestinationFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- toolbar: count | tree toggle | search (search stretches, then shrinks when narrow) -->
                    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="Source files (" /><Run Text="{Binding Sources.VisibleRows.Count}" /><Run Text=")" />
                        </TextBlock>
                        <ToggleButton Grid.Column="1" Content="Tree view" IsChecked="{Binding Sources.ShowTree}"
                                      FontSize="12" Margin="12,0,8,0" VerticalAlignment="Center"
                                      ToolTip.Tip="Group the files into a navigable directory tree" />
                        <TextBox Grid.Column="2" MaxWidth="280" HorizontalAlignment="Stretch" Text="{Binding Sources.SearchText}"
                                 PlaceholderText="Filter by source or target path…" />
                    </Grid>

                    <ListBox Grid.Row="5" Classes="rows" ItemsSource="{Binding Sources.VisibleRows}"
                             IsVisible="{Binding !Sources.ShowTree}"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DryRunFileRow">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                                        Padding="4,6" ToolTip.Tip="{Binding SourcePath}">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        <!-- line 1: file name (extension preserved on truncation) -->
                                        <ctrl:PathText Grid.Row="0" Grid.Column="0" Text="{Binding FileName}"
                                                       Mode="EndPreservingExtension" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="13" VerticalAlignment="Center" Opacity="{Binding ContentOpacity}" />

                                        <!-- line 1: pills — target-op kind, then source status -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border Classes="chip" IsVisible="{Binding HasTargetKind}"
                                                    Classes.chipDanger="{Binding IsPrimaryOverwrite}"
                                                    Classes.chipAmber="{Binding IsPrimaryRename}"
                                                    Classes.chipSafe="{Binding IsPrimaryWrite}"
                                                    Classes.chipMuted="{Binding IsPrimarySkip}">
                                                <TextBlock Text="{Binding PrimaryKindText}" FontSize="11" />
                                            </Border>
                                            <Border Classes="chip chipInfo" IsVisible="{Binding IsUntouched}">
                                                <TextBlock Text="Untouched" FontSize="11" />
                                            </Border>
                                            <Border Classes="chip chipSafe" IsVisible="{Binding IsProcessed}">
                                                <TextBlock Text="Processed" FontSize="11" />
                                            </Border>
                                            <Border Classes="chip chipDanger" IsVisible="{Binding IsDeleted}">
                                                <TextBlock Text="Deleted" FontSize="11" />
                                            </Border>
                                        </StackPanel>

                                        <!-- line 2: parent directory (relative, folder-truncated) + right-aligned size -->
                                        <ctrl:PathText Grid.Row="1" Grid.Column="0" Text="{Binding ParentDisplay}"
                                                       Mode="FolderMiddleEllipsis" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Margin="0,2,0,0" Opacity="0.6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}"
                                                   FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,2,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TreeDataGrid Grid.Row="5" Classes="rows" Source="{Binding Sources.TreeSource}"
                                  IsVisible="{Binding Sources.ShowTree}" />
                </Grid>

                <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                              Background="{DynamicResource SystemControlBackgroundListLowBrush}" />

                <!-- ============================ DESTINATIONS ============================ -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8" Margin="8,8,0,0">

                    <TextBlock Grid.Row="0" Text="Destinations" FontWeight="Bold" FontSize="14" />

                    <TextBlock Grid.Row="1" Text="{Binding Destinations.CommonRootDisplay}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Destinations.CommonRoot}" />

                    <WrapPanel Grid.Row="2">
                        <Border Classes="chip chipInfo" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Destinations.UntouchedCount}" /><Run Text=" untouched" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipSafe" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Destinations.NewCount}" /><Run Text=" new" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipAmber" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Destinations.OverwrittenCount}" /><Run Text=" overwritten" /></TextBlock>
                        </Border>
                        <Border Classes="chip chipDanger" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding Destinations.DeletedCount}" /><Run Text=" deleted" /></TextBlock>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Row="3" Spacing="6">
                        <Border IsVisible="{Binding Destinations.ShowSourceFacet}"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="6" Padding="10,6">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Sources:" FontWeight="SemiBold" VerticalAlignment="Center"
                                           DockPanel.Dock="Left" Margin="0,0,8,0" />
                                <ItemsControl ItemsSource="{Binding Destinations.SourceFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <Border IsVisible="{Binding Destinations.ShowDestinationFacet}"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="6" Padding="10,6">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Destinations:" FontWeight="SemiBold" VerticalAlignment="Center"
                                           DockPanel.Dock="Left" Margin="0,0,8,0" />
                                <ItemsControl ItemsSource="{Binding Destinations.DestinationFacets}" ItemTemplate="{StaticResource FacetTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="Destination files (" /><Run Text="{Binding Destinations.VisibleRows.Count}" /><Run Text=")" />
                        </TextBlock>
                        <ToggleButton Grid.Column="1" Content="Tree view" IsChecked="{Binding Destinations.ShowTree}"
                                      FontSize="12" Margin="12,0,8,0" VerticalAlignment="Center"
                                      ToolTip.Tip="Group the resulting files into a navigable directory tree" />
                        <TextBox Grid.Column="2" MaxWidth="280" HorizontalAlignment="Stretch" Text="{Binding Destinations.SearchText}"
                                 PlaceholderText="Filter by destination or source path…" />
                    </Grid>

                    <ListBox Grid.Row="5" Classes="rows" ItemsSource="{Binding Destinations.VisibleRows}"
                             IsVisible="{Binding !Destinations.ShowTree}"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DryRunDestinationRow">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                                        Padding="4,6">
                                    <Panel>
                                        <!-- No-source row (a Mirror deletion, a kept-around conflict original, a
                                             pre-existing untouched file): the classic filename + status + folder layout. -->
                                        <Grid IsVisible="{Binding IsSingle}" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                                              ToolTip.Tip="{Binding Primary.TargetPath}">
                                            <ctrl:PathText Grid.Row="0" Grid.Column="0" Text="{Binding FileName}"
                                                           Mode="EndPreservingExtension" FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="13" VerticalAlignment="Center" />
                                            <Border Grid.Row="0" Grid.Column="1" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Classes.chipInfo="{Binding Primary.IsUntouched}"
                                                    Classes.chipSafe="{Binding Primary.IsNew}"
                                                    Classes.chipAmber="{Binding Primary.IsOverwritten}"
                                                    Classes.chipDanger="{Binding Primary.IsDeleted}"
                                                    Classes.chipMuted="{Binding Primary.IsUnknown}">
                                                <TextBlock Text="{Binding Primary.StatusText}" FontSize="11" />
                                            </Border>
                                            <ctrl:PathText Grid.Row="1" Grid.Column="0" Text="{Binding Primary.ParentDisplay}"
                                                           Mode="FolderMiddleEllipsis" FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11" Margin="0,2,0,0" Opacity="0.6" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Primary.SizeText}"
                                                       FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Margin="8,2,0,0" />
                                        </Grid>

                                        <!-- Source-backed row: the source file on top, then every destination it fans
                                             out to as a wrapping list of chips, each coloured by its own status. -->
                                        <StackPanel IsVisible="{Binding HasSource}" Spacing="4" ToolTip.Tip="{Binding SourcePath}">
                                            <ctrl:PathText Text="{Binding FileName}" Mode="EndPreservingExtension"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="13" />
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="from" DockPanel.Dock="Left" FontSize="11" Opacity="0.5"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ctrl:PathText Text="{Binding SourceDisplay}" Mode="FolderMiddleEllipsis"
                                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Opacity="0.6" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Destinations}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DryRunDestinationEntry">
                                                        <Border Classes="chip" Margin="0,0,6,4" ToolTip.Tip="{Binding TargetPath}"
                                                                Classes.chipInfo="{Binding IsUntouched}"
                                                                Classes.chipSafe="{Binding IsNew}"
                                                                Classes.chipAmber="{Binding IsOverwritten}"
                                                                Classes.chipDanger="{Binding IsDeleted}"
                                                                Classes.chipMuted="{Binding IsUnknown}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding RelativeDisplay}" FontFamily="{StaticResource MonoFontFamily}"
                                                                           FontSize="11" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                                           Opacity="0.85" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Opacity="0.7"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TreeDataGrid Grid.Row="5" Classes="rows" Source="{Binding Destinations.TreeSource}"
                                  IsVisible="{Binding Destinations.ShowTree}" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>

</UserControl>

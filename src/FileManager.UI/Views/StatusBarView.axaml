<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             x:Class="FileManager.UI.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

    <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" Padding="10,5">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center"
                     IsVisible="{Binding IsConnected}" />
            <Ellipse Width="10" Height="10" Fill="#E53935" VerticalAlignment="Center"
                     IsVisible="{Binding !IsConnected}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>

</UserControl>

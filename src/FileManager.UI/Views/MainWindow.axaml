<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:v="using:FileManager.UI.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="FileManager.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="760"
        Title="File Manager"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <!-- Avalonia 12 draws its own caption buttons when the client area is extended; hide the
             full-screen button so it doesn't sit over our title-bar folder/gear buttons. -->
        <Style Selector="chrome|WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
        </Style>

        <!-- Flat, transparent icon buttons used in the title bar and the profile toolbar. -->
        <Style Selector="Button.iconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Custom title bar: extends into the OS caption area. The right StackPanel reserves space
             so its icon buttons never sit under the system min/max/close buttons. -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="Transparent"
              ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="File Manager" VerticalAlignment="Center"
                       Margin="12,0,0,0" FontSize="12" Opacity="0.8" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,150,0">
                <Button Classes="iconButton" Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open log folder">
                    <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
                </Button>
                <Button Classes="iconButton" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
                    <PathIcon Data="{StaticResource IconGear}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>

        <v:StatusBarView DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />

        <Grid ColumnDefinitions="280,4,*">
            <DockPanel Grid.Column="0" Margin="8">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <Button Grid.Column="0" Classes="iconButton" Command="{Binding List.RefreshCommand}" ToolTip.Tip="Refresh">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                    </Button>
                    <TextBox Grid.Column="1" Text="{Binding List.SearchText}"
                             PlaceholderText="Search profiles…" Margin="6,0">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                                      Margin="6,0,0,0" Opacity="0.6" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="2" Classes="iconButton" Command="{Binding NewProfileCommand}" ToolTip.Tip="New profile">
                        <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                    </Button>
                </Grid>
                <v:ProfileListView DataContext="{Binding List}" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

            <TabControl Grid.Column="2" Margin="4,8,8,8" IsVisible="{Binding Editor.HasProfile}">
                <TabItem Header="Profile">
                    <v:ProfileEditorView DataContext="{Binding Editor}" />
                </TabItem>
                <TabItem Header="Dry Run" IsEnabled="{Binding DryRun.CanRun}">
                    <v:DryRunView DataContext="{Binding DryRun}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

</Window>

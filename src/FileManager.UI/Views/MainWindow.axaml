<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:v="using:FileManager.UI.Views"
        x:Class="FileManager.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="760"
        Title="File Manager">

    <DockPanel>
        <v:StatusBarView DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />

        <Grid ColumnDefinitions="280,4,*">
            <DockPanel Grid.Column="0" Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                    <Button Content="New profile" Command="{Binding NewProfileCommand}" />
                    <Button Content="Refresh" Command="{Binding List.RefreshCommand}" />
                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                </StackPanel>
                <v:ProfileListView DataContext="{Binding List}" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

            <TabControl Grid.Column="2" Margin="4,8,8,8" IsVisible="{Binding Editor.HasProfile}">
                <TabItem Header="Profile">
                    <v:ProfileEditorView DataContext="{Binding Editor}" />
                </TabItem>
                <TabItem Header="Dry Run" IsEnabled="{Binding DryRun.CanRun}">
                    <v:DryRunView DataContext="{Binding DryRun}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

</Window>

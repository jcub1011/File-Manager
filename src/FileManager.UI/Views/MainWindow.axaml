<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.UI.ViewModels"
        xmlns:v="using:FileManager.UI.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="FileManager.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="760"
        Title="File Manager"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource Font.Body}"
        Background="{DynamicResource Brush.Window.Background}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <!-- Caption- and icon-button styles now live in Themes/Controls.axaml (app-wide). -->

    <DockPanel>
        <!-- Custom title bar (Avalonia 12 WindowDecorations="BorderOnly" + ElementRole markers). The
             OS keeps the resizable window frame but draws no system title bar, so there is nothing to
             reserve space for — no hardcoded margins, DPI- and platform-independent. ElementRole="TitleBar" makes the grid the drag +
             double-click-maximize region. CRITICAL: every interactive child must carry its own role
             (User for app buttons, {Min,Max,Close}Button for the caption buttons) or the drag region
             swallows its clicks. The role only routes input — the Click handlers still do the work. -->
        <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource Brush.Chrome.Background}"
              ColumnDefinitions="Auto,*,Auto"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource Brush.Accent}">
                    <PathIcon Data="{StaticResource IconFolder}" Width="11" Height="11" Foreground="White" />
                </Border>
                <TextBlock Text="File Manager" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="{StaticResource Font.Title}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="iconButton" chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding ImportProfilesCommand}" ToolTip.Tip="Import profiles">
                    <PathIcon Data="{StaticResource IconImport}" Width="16" Height="16" />
                </Button>
                <Button Classes="iconButton" chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding ExportProfilesCommand}" ToolTip.Tip="Export profiles">
                    <PathIcon Data="{StaticResource IconExport}" Width="16" Height="16" />
                </Button>
                <!-- The job QUEUE (runs) is a separate window from the activity PANEL (files) beside it.
                     Two levels, two places: a run is what you pause and cancel, a file job is what you
                     drill into. The badge counts runs that have not finished, so the button says whether
                     opening it is worth it. -->
                <Button Classes="iconButton" chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding OpenJobQueueCommand}" ToolTip.Tip="Job queue">
                    <Panel>
                        <PathIcon Data="{StaticResource IconOverwrite}" Width="16" Height="16" />
                        <Border Background="{DynamicResource Brush.Info}" CornerRadius="7"
                                MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-5,-6,0"
                                IsVisible="{Binding Queue.ActiveCount}">
                            <TextBlock Text="{Binding Queue.ActiveCount}" Foreground="White"
                                       FontSize="{StaticResource Font.Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                </Button>
                <Button Classes="iconButton" chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding ToggleActivityCommand}" ToolTip.Tip="Activity">
                    <PathIcon Data="{StaticResource IconDocument}" Width="16" Height="16" />
                </Button>
                <Button Classes="iconButton" chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open log folder">
                    <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
                </Button>
                <Button Classes="iconButton" chrome:WindowDecorationProperties.ElementRole="User"
                        Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" Margin="0,0,8,0">
                    <PathIcon Data="{StaticResource IconGear}" Width="16" Height="16" />
                </Button>

                <Button Classes="caption" chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                        Click="OnMinimize" ToolTip.Tip="Minimize">
                    <PathIcon Data="{StaticResource IconMinimize}" Width="10" Height="10" />
                </Button>
                <Button x:Name="MaximizeButton" Classes="caption"
                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                        Click="OnMaximizeRestore" ToolTip.Tip="Maximize">
                    <PathIcon x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Width="10" Height="10" />
                </Button>
                <Button Classes="caption close" chrome:WindowDecorationProperties.ElementRole="CloseButton"
                        Click="OnClose" ToolTip.Tip="Close">
                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <v:StatusBarView DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />

        <!-- Activity panel. Declared AFTER the status bar so it docks above it, and deliberately
             outside the document grid below — that grid is gated on Editor.HasProfile, and engine
             activity is global state that must stay visible with no profile selected. The IsVisible
             sits on this wrapper because the child's DataContext is swapped to Activity. -->
        <ContentControl DockPanel.Dock="Bottom" Height="220" IsVisible="{Binding ActivityVisible}">
            <v:ActivityView DataContext="{Binding Activity}" />
        </ContentControl>

        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <!-- Width is driven from code-behind (MainWindow.axaml.cs); the column stays freely
                     draggable down to the rail width, and the current width decides collapsed vs
                     expanded (dragging across the 180px threshold switches modes). -->
                <ColumnDefinition Width="280" MinWidth="58" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Left tool-window: PROFILES. Its own panel surface + a divider border against the
                 document area on the right. Two content modes coexist and toggle on SidebarCollapsed:
                 the full list, or the collapsed acronym rail. The mode toggle lives on this Border
                 (MainWindow DataContext), while the rail's own DataContext is reassigned to List. -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Panel.Background}"
                    BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="0,0,1,0">
                <Panel>
                    <DockPanel Margin="8,10,8,8" IsVisible="{Binding !SidebarCollapsed}">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,8">
                            <TextBlock Grid.Column="0" Classes="panelHeader" Text="PROFILES" />
                            <Button Grid.Column="1" Classes="iconButton" Command="{Binding List.RefreshCommand}" ToolTip.Tip="Refresh">
                                <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                            </Button>
                            <Button Grid.Column="2" Classes="iconButton" Command="{Binding NewProfileCommand}" ToolTip.Tip="New profile">
                                <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                        <TextBox DockPanel.Dock="Top" Text="{Binding List.SearchText}"
                                 PlaceholderText="Search profiles…" Margin="0,0,0,8">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                                          Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <v:ProfileListView DataContext="{Binding List}" />
                    </DockPanel>

                    <ContentControl IsVisible="{Binding SidebarCollapsed}">
                        <v:ProfileRailView DataContext="{Binding List}" />
                    </ContentControl>
                </Panel>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Background="Transparent"
                          ResizeDirection="Columns" ToolTip.Tip="Double-click to collapse or expand" />

            <!-- Document area: tabs, with each tab's primary action buttons overlaid at the
                 right of the header strip (context-switched by the active tab's IsSelected). -->
            <Grid Grid.Column="2" Margin="8,6,10,8" IsVisible="{Binding Editor.HasProfile}">
                <!-- SelectedIndex is bound because a preview NAVIGATES: pressing Preview on the Profile
                     tab has to land the user on the Preview tab where the rows appear. No IsEnabled gate
                     on the Preview tab — a programmatic selection would fight it. -->
                <TabControl Classes="documents" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem x:Name="ProfileTab" Header="Profile">
                        <v:ProfileEditorView DataContext="{Binding Editor}" />
                    </TabItem>
                    <TabItem x:Name="PreviewTab" Header="Preview">
                        <v:DryRunView DataContext="{Binding DryRun}" />
                    </TabItem>
                </TabControl>

                <!-- Action buttons on the tab-header row (right side). Each sub-group re-typed for
                     compiled bindings and shown only while its tab is active. -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                            Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                DataContext="{Binding Editor}" x:DataType="vm:ProfileEditorViewModel"
                                IsVisible="{Binding #ProfileTab.IsSelected}">
                        <!-- Icon-only throughout, so the whole strip reads as one toolbar. The glyph tints
                             carry what the old solid fills did: accent = commit, red = destructive,
                             green = go. Every button names itself in a tooltip, since nothing else does. -->
                        <!-- Discard leads, even though it reads out of order next to Undo/Redo: it is the
                             only button here that comes and goes (IsDirty), and this group is right-anchored,
                             so appearing at the head grows the group leftwards and leaves every other button
                             under the cursor where it was. Anywhere else it shifts its neighbours.
                             The ✕ runs a size smaller than the rest: a bare cross fills its box corner to
                             corner and optically overshoots the outline glyphs beside it at a matched size. -->
                        <Button Classes="iconButton" Command="{Binding DiscardCommand}"
                                IsVisible="{Binding IsDirty}" ToolTip.Tip="Discard changes">
                            <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                        </Button>
                        <!-- Undo/Redo sit ahead of the commit actions: they act on the edits in progress
                             rather than resolving the draft. They run the same commands the Ctrl+Z / Ctrl+Y
                             shortcuts in ProfileEditorView do, so the buttons and the keyboard cannot drift
                             apart. -->
                        <Button Classes="iconButton" Command="{Binding History.UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
                            <PathIcon Data="{StaticResource IconUndo}" Width="16" Height="16" />
                        </Button>
                        <Button Classes="iconButton" Command="{Binding History.RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)">
                            <PathIcon Data="{StaticResource IconRedo}" Width="16" Height="16" />
                        </Button>
                        <Button Classes="iconButton tintAccent" Command="{Binding SaveCommand}"
                                ToolTip.Tip="Save">
                            <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Delete takes the selected list row (it acts on the PERSISTED profile); Preview
                         takes it only to name the profile, since it plans the editor's draft. Both stay at
                         shell scope, so no DataContext override here. -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding #ProfileTab.IsSelected}">
                        <Button Classes="iconButton tintDanger"
                                Command="{Binding DeleteProfileCommand}"
                                CommandParameter="{Binding List.SelectedProfile}"
                                IsEnabled="{Binding List.CanDeleteSelected}"
                                ToolTip.Tip="Delete — permanently removes this profile">
                            <PathIcon Data="{StaticResource IconTrash}" Width="16" Height="16" />
                        </Button>
                        <!-- A spyglass, not a play triangle: this button inspects, and the only button in
                             the app that starts moving files is Approve Run. With the label gone the glyph
                             is the whole argument, so the tooltip still spells out what a preview does. -->
                        <!-- Disabled while a preview is in flight, matching the Preview tab's twin below.
                             The SplitButton this replaced awaited the whole dry run, so its command stayed
                             disabled for the scan and a second concurrent run was impossible; the icon
                             button returns as soon as the engine ACCEPTS the run, so without this a second
                             press starts a second full scan of the same tree. -->
                        <Button Classes="iconButton tintSuccess"
                                Command="{Binding PreviewProfileCommand}"
                                CommandParameter="{Binding List.SelectedProfile}"
                                IsEnabled="{Binding !DryRun.IsPreviewing}"
                                ToolTip.Tip="Preview — works out exactly what this profile will do and shows it on the Preview tab. Nothing is copied or deleted until you approve it there.">
                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Preview tab: re-previewing is the shell's command (it owns the run's lifecycle),
                         so this group stays at shell scope and reads the child VM for its busy state. -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding #PreviewTab.IsSelected}">
                        <!-- Planning a large profile is minutes of walking, and free to abandon: nothing
                             has been touched. Only offered once the engine has accepted the run, which is
                             when there is an id to cancel. Like Discard on the Profile tab it leads the
                             group: it is the one button here that comes and goes, and a right-anchored
                             group only stays still under the cursor if the transient member is at the head. -->
                        <Button Classes="iconButton" Command="{Binding DryRun.CancelPreviewCommand}"
                                IsVisible="{Binding DryRun.PlanningRunId,
                                                    Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="Cancel — stops planning. Nothing has been touched.">
                            <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                        </Button>
                        <!-- A refresh arrow rather than the Profile tab's spyglass: arriving here the plan
                             is already on screen, so this button's job is to redo it, not to go look. -->
                        <Button Classes="iconButton tintSuccess"
                                Command="{Binding PreviewProfileCommand}"
                                CommandParameter="{Binding List.SelectedProfile}"
                                IsEnabled="{Binding !DryRun.IsPreviewing}"
                                ToolTip.Tip="Preview — re-plans this profile from scratch">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Empty state: shown whenever no profile is loaded in the editor. The message switches
                 on whether any profiles exist at all (List.HasProfiles): none → create one; some →
                 pick one. Text-only; the actionable "+" lives in the sidebar. -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" MaxWidth="360" IsVisible="{Binding !Editor.HasProfile}">
                <PathIcon Data="{StaticResource IconFolder}" Width="40" Height="40"
                          HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
                <StackPanel Spacing="4" IsVisible="{Binding List.HasProfiles}">
                    <TextBlock Text="No profile selected" Classes="panelHeader" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a profile in the sidebar to get started."
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding !List.HasProfiles}">
                    <TextBlock Text="No profiles yet" Classes="panelHeader" HorizontalAlignment="Center" />
                    <TextBlock Text="Create a profile using the + in the sidebar to get started."
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>

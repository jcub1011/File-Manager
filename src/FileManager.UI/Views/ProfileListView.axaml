<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             x:Class="FileManager.UI.Views.ProfileListView"
             x:DataType="vm:ProfileListViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="infoBar danger" Margin="0,0,0,6"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="infoBar danger" Margin="0,8,0,0"
                IsVisible="{Binding PendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Delete profile " /><Run Text="{Binding PendingDelete.Name}" FontWeight="Bold" /><Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Classes="danger" />
                    <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox Classes="profiles" ItemsSource="{Binding FilteredProfiles}" SelectedItem="{Binding SelectedProfile}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileListItem">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="caption" Text="{Binding ActiveText}" />
                                <TextBlock Classes="caption" Text="{Binding TriggerSummary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="iconButton" Padding="6,4" VerticalAlignment="Center"
                                ToolTip.Tip="Delete profile"
                                Command="{Binding $parent[ListBox].((vm:ProfileListViewModel)DataContext).RequestDeleteCommand}"
                                CommandParameter="{Binding}">
                            <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>

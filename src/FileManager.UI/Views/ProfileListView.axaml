<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             x:Class="FileManager.UI.Views.ProfileListView"
             x:DataType="vm:ProfileListViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#E53935"
                   TextWrapping="Wrap" Margin="0,0,0,6"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8"
                Background="#33E53935" CornerRadius="4"
                IsVisible="{Binding PendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Delete profile " /><Run Text="{Binding PendingDelete.Name}" FontWeight="Bold" /><Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Background="#E53935" Foreground="White" />
                    <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileListItem">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ActiveText}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding TriggerSummary}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,2" VerticalAlignment="Center"
                                Command="{Binding $parent[ListBox].((vm:ProfileListViewModel)DataContext).RequestDeleteCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>

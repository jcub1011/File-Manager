<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileManager.UI.ViewModels"
             xmlns:conv="using:FileManager.UI.Converters"
             x:Class="FileManager.UI.Views.ProfileListView"
             x:DataType="vm:ProfileListViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="infoBar danger" Margin="0,0,0,6"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Deleting confirms in a modal (App.axaml.cs) rather than an inline bar here: delete is also
             reachable from the collapsed rail, which never renders this view. -->

        <ListBox Classes="profiles" ItemsSource="{Binding FilteredProfiles}" SelectedItem="{Binding SelectedProfile}">
            <ListBox.Styles>
                <!-- While the editor has unsaved edits, lock every row except the one being edited so
                     the user can't appear to navigate away (a new, idless draft locks all rows). -->
                <Style Selector="ListBoxItem">
                    <Setter Property="IsEnabled">
                        <MultiBinding Converter="{x:Static conv:MultiValueConverters.RowSelectable}">
                            <Binding Path="((vm:ProfileListViewModel)DataContext).HasUnsavedChanges"
                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                            <Binding Path="((vm:ProfileListItem)DataContext).ProfileId"
                                     RelativeSource="{RelativeSource Self}" />
                            <Binding Path="((vm:ProfileListViewModel)DataContext).UnsavedProfileId"
                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        </MultiBinding>
                    </Setter>
                    <!-- Move the row inset into the template's Border so the whole row (padding
                         included) is a hit-testable surface for the right-click context menu. -->
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileListItem">
                    <!-- Transparent full-bleed surface carrying the row inset: makes the entire row
                         (not just where text/icons sit) respond to a right-click. -->
                    <Border Background="Transparent" Padding="8,3">
                        <Border.ContextMenu>
                            <ContextMenu x:DataType="vm:ProfileListItem">
                                <MenuItem Header="Preview…" Command="{Binding RunCommand}" CommandParameter="{Binding}"
                                          IsEnabled="{Binding Active}"
                                          ToolTip.Tip="Opens this profile and works out exactly what it will do. Nothing is copied or deleted until you approve it.">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Export…" Command="{Binding ExportCommand}" CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="caption" Text="{Binding ActiveText}" />
                                    <TextBlock Classes="caption" Text="{Binding TriggerSummary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="●" VerticalAlignment="Center" Margin="0,0,2,0"
                                       Foreground="{DynamicResource Brush.Accent}" ToolTip.Tip="Unsaved changes">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:MultiValueConverters.GuidEquals}">
                                        <Binding Path="ProfileId" />
                                        <Binding Path="$parent[ListBox].((vm:ProfileListViewModel)DataContext).UnsavedProfileId" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:FileManager.UI.Converters"
             xmlns:vm="using:FileManager.UI.ViewModels"
             x:Class="FileManager.UI.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

    <!-- Bottom tool window: recent jobs with outcome, and drill-down into the per-job log (spec §7).
         Lives OUTSIDE the document area's profile gate because engine activity is global state. -->
    <Border Background="{DynamicResource Brush.Panel.Background}"
            BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="0,1,0,0">
        <DockPanel Margin="10,8,10,8">

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="panelHeader" Text="ACTIVITY" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="caption" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="Recent jobs are held in memory by the service and reset when it restarts."
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Classes="iconButton" Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="3" Classes="iconButton" Command="{Binding HideCommand}"
                        ToolTip.Tip="Hide the activity panel">
                    <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                </Button>
            </Grid>

            <Border DockPanel.Dock="Top" Classes="infoBar danger" Margin="0,0,0,6"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Dismissable: a notice is informational, so nothing else ever clears it while the panel
                 stays open, and without a close button one stale message outlived the run it described. -->
            <Border DockPanel.Dock="Top" Classes="infoBar info" Margin="0,0,0,6"
                    IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Notice}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="iconButton" Command="{Binding DismissNoticeCommand}"
                            Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Dismiss">
                        <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9" />
                    </Button>
                </Grid>
            </Border>

            <TextBlock DockPanel.Dock="Top" Classes="caption" Text="No recent jobs."
                       IsVisible="{Binding !HasJobs}" />

            <Grid ColumnDefinitions="360,4,*" IsVisible="{Binding HasJobs}">
                <ListBox Grid.Column="0" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityRow">
                            <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding SourcePath}">
                                <!-- Glyph + colour arrive as resource-key strings from the view model,
                                     resolved here — the same approach the dry-run rows use, so the
                                     view model needs no Avalonia dependency. -->
                                <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Data="{Binding StatusIconKey, Converter={x:Static conv:IconConverters.Geometry}}"
                                          Foreground="{Binding StatusColorKey, Converter={x:Static conv:IconConverters.Brush}}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding StartedText}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding StatusText}" />
                                    </TextBlock>
                                    <TextBlock Classes="caption" Text="{Binding ProgressText}"
                                               Foreground="{DynamicResource Brush.Info}"
                                               IsVisible="{Binding ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Classes="caption" Text="{Binding ProfileName}"
                                               IsVisible="{Binding ProfileName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

                <DockPanel Grid.Column="2" Margin="8,0,0,0">
                    <!-- Residual paths are the one outcome that needs the user to act, so they sit
                         above the log rather than buried in it. -->
                    <Border DockPanel.Dock="Top" Classes="infoBar danger" Margin="0,0,0,6"
                            IsVisible="{Binding SelectedJob.HasResidualPaths, FallbackValue=False}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Rollback could not restore these paths — they need manual cleanup:"
                                       TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedJob.ResidualPathsText}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFontFamily}" />
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{Binding SelectedJob.Error}"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource Brush.Danger}"
                               IsVisible="{Binding SelectedJob.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{Binding LogStatus}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding LogStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="{StaticResource Font.Small}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>

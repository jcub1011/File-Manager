        <!-- Trash can — Fluent delete (Regular outline) with the two inner ridge lines removed, so
             it reads as a clean hollow can. The third subpath is the inner-body cutout that makes the
             can hollow (its moveto is rewritten to absolute since the removed ridge subpaths used to
             precede it). -->
        <StreamGeometry x:Key="IconTrash">M10 5h4a2 2 0 1 0-4 0ZM8.5 5a3.5 3.5 0 1 1 7 0h5.75a.75.75 0 0 1 0 1.5h-1.32l-1.17 12.11A3.75 3.75 0 0 1 15.03 22H8.97a3.75 3.75 0 0 1-3.73-3.39L4.07 6.5H2.75a.75.75 0 0 1 0-1.5H8.5ZM6.73 18.47a2.25 2.25 0 0 0 2.24 2.03h6.06c1.15 0 2.12-.88 2.24-2.03L18.42 6.5H5.58l1.15 11.97Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml" />
        <!-- Shared class-based styles; included last so they layer over the Fluent defaults. -->
        <StyleInclude Source="avares://FileManager.UI/Themes/Controls.axaml" />
    </Application.Styles>
</Application>

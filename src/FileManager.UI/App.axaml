<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileManager.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Central design tokens (theme-aware brushes + scalars). Merged at the app level so
                     they resolve for every window and outrank the FluentTheme defaults. -->
                <ResourceInclude Source="avares://FileManager.UI/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Monospaced family for the dry-run path columns: a uniform glyph advance lets PathText
             fit text by character count. Concrete faces first (Consolas ships on Windows); the
             generic "monospace" tail is just insurance. -->
        <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Menlo, monospace</FontFamily>

        <!-- Shared vector icon geometries (Fluent System Icons, 24x24 viewbox, Regular/outline
             weight), rendered via PathIcon so they inherit the theme Foreground and track the
             light/dark variant. This is Microsoft's own icon language — a clean, cohesive match
             for the Windows chrome and the Visual Studio look. -->
